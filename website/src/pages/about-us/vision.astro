---
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout 
  title="Vision | GlobSol Power Pvt Ltd"
  description="Becoming the Customer's Most Valued Service Provider and Leading the Nation Towards Renewable Energy."
>
  <!-- Page Banner Section -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8 mx-auto">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">About GlobSol</span>
          <h1 class="display-4 fw-bold text-white mb-3">Our Strategic Vision</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-0">
            "Becoming the Customer's Most Valued Service Provider & Leading the Nation Towards Renewable Energy"
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 1. Vision Pillars Section -->
  <section id="vision-pillars" class="py-5 bg-light">
    <div class="container">
      <div class="row">
        <div class="col-xl-9 col-lg-10 mx-auto text-center">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInUp" data-wow-delay=".2s">Pillars of Excellence</span>
            <h2 class="mb-3 wow fadeInUp" data-wow-delay=".4s">Unpacking Our Vision</h2>
            <p class="wow fadeInUp text-secondary" data-wow-delay=".5s">Our strategic roadmap combines customer-first engineering with sustainable innovation across electrical, solar, and civil sectors.</p>
          </div>
        </div>
      </div>

      <div class="row g-4 justify-content-center">
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="row align-items-center g-3">
              <div class="col-auto">
                <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm bg-gs-gradient" style="width: 52px; height: 52px;">
                  <i class="lni lni-user fs-4"></i>
                </div>
              </div>
              <div class="col">
                <h4 class="h5 fw-bold text-dark mb-1">1. Customer-Centric Partnership</h4>
                <p class="text-secondary mb-0 small">We aspire to be more than a conventional service provider. By consistently delivering technical precision, clear communication, and post-project reliability, we earn the distinction of being our clients' most trusted engineering ally.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="row align-items-center g-3">
              <div class="col-auto">
                <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm bg-gs-gradient" style="width: 52px; height: 52px;">
                  <i class="lni lni-sun fs-4"></i>
                </div>
              </div>
              <div class="col">
                <h4 class="h5 fw-bold text-dark mb-1">2. Driving Renewable Energy Adoption</h4>
                <p class="text-secondary mb-0 small">Our vision extends beyond traditional contracting. We are committed to leading the transition towards turnkey solar PV EPC and clean energy microgrids, empowering industries and communities with sustainable power.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Guiding Principles Section -->
  <section id="guiding-principles" class="py-5 bg-white">
    <div class="container">
      <div class="row">
        <div class="col-xl-6 col-lg-7 col-md-9 mx-auto">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInDown" data-wow-delay=".2s">Core Values</span>
            <h2 class="wow fadeInUp" data-wow-delay=".4s">Guiding Principles</h2>
            <p class="wow fadeInUp text-secondary" data-wow-delay=".6s">The foundational tenets that guide every engineering project and client interaction.</p>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-light rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".2s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fs-4 mx-auto mb-3">
              <i class="lni lni-bulb"></i>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">Innovation</h4>
              <p class="text-secondary small mb-0">Continuously adopting cutting-edge technologies to solve complex electrical & civil engineering challenges.</p>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-light rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".4s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fs-4 mx-auto mb-3">
              <i class="lni lni-leaf"></i>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">Sustainability</h4>
              <p class="text-secondary small mb-0">Embedding environmental responsibility and energy efficiency into every solar and building project.</p>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-light rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".6s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fs-4 mx-auto mb-3">
              <i class="lni lni-users"></i>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">Collaboration</h4>
              <p class="text-secondary small mb-0">Fostering strong relationships with public authorities, defense entities, and corporate clients.</p>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-light rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".8s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fs-4 mx-auto mb-3">
              <i class="lni lni-stats-up"></i>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">Improvement</h4>
              <p class="text-secondary small mb-0">Maintaining a culture of continuous learning, safety compliance, and process refinement.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Callout Banner -->
  <section id="connect" class="py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">Join Our Quest</span>
      <h2 class="display-5 fw-bold text-white mb-3">Shaping a Sustainable Energy Future</h2>
      <p class="lead text-white-50 max-w-xl mx-auto mb-4">
        Join us on this visionary quest at GlobSol, where we are not just shaping a future of customer-centric excellence, but also leading the charge towards a self-reliant, green nation.
      </p>
      <div class="d-flex justify-content-center align-items-center flex-wrap gap-3">
        <a href={`${baseUrl}contact`} class="btn btn-light btn-lg fw-bold text-primary px-4 rounded-pill shadow-sm">Partner With Us</a>
        <a href={`${baseUrl}services`} class="btn btn-outline-light btn-lg fw-bold px-4 rounded-pill">Explore Services</a>
      </div>
    </div>
  </section>
</BaseLayout>
