---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Mission | GlobSol Power Pvt Ltd"
  description="Delivering Unparalleled Quality Services to Our Customers across civil construction, electrical contracting, and solar EPC."
>
  <!-- Page Banner Section -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8 mx-auto">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">About GlobSol</span>
          <h1 class="display-4 fw-bold text-white mb-3">Our Engineering Mission</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-0">
            "Delivering Unparalleled Quality Services & Engineering Precision to Every Customer"
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 1. Core Mission Statement Section -->
  <section id="mission-statement" class="py-5 bg-light">
    <div class="container">
      <div class="row">
        <div class="col-xl-9 col-lg-10 mx-auto text-center">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInUp" data-wow-delay=".2s">Our Commitment</span>
            <h2 class="mb-3 wow fadeInUp" data-wow-delay=".4s">Excellence in Execution</h2>
            <p class="lead text-secondary wow fadeInUp" data-wow-delay=".5s">
              At GlobSol, our mission is simple yet profound: to provide the highest quality engineering services to our clients. This pledge permeates every phase of our operations — from initial design and CEIG statutory approvals to turnkey execution and maintenance.
            </p>
          </div>
        </div>
      </div>

      <!-- 4 Core Pillars of Mission -->
      <div class="row g-4">
        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-white rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".2s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fs-4 mx-auto mb-3">
              <i class="lni lni-shield"></i>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">Uncompromising Quality</h4>
              <p class="text-secondary small mb-0">Setting a non-negotiable benchmark in civil safety, high-voltage 33kV substations, and solar PV engineering.</p>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-white rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".4s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fs-4 mx-auto mb-3">
              <i class="lni lni-user"></i>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">Client-Centric Approach</h4>
              <p class="text-secondary small mb-0">Custom-tailoring engineering solutions to meet unique operational needs, timelines, and statutory criteria.</p>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-white rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".6s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fs-4 mx-auto mb-3">
              <i class="lni lni-cog"></i>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">Technical Mastery</h4>
              <p class="text-secondary small mb-0">Employing modern tools, Class-1 certified engineers, and standardized procedures on every site.</p>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-white rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".8s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fs-4 mx-auto mb-3">
              <i class="lni lni-checkmark-circle"></i>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">Team Empowerment</h4>
              <p class="text-secondary small mb-0">Nurturing a culture of continuous learning, field safety audits, and professional craftsmanship.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Standards & Values Section -->
  <section id="mission-values" class="py-5 bg-white">
    <div class="container">
      <div class="row">
        <div class="col-xl-6 col-lg-7 col-md-9 mx-auto">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInDown" data-wow-delay=".2s">Operational Ethos</span>
            <h2 class="wow fadeInUp" data-wow-delay=".4s">Our Execution Standards</h2>
            <p class="wow fadeInUp text-secondary" data-wow-delay=".6s">How we translate our mission into day-to-day project milestones.</p>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-md-6">
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 wow fadeInUp" data-wow-delay=".2s">
            <div class="row align-items-center g-3">
              <div class="col-auto">
                <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 52px; height: 52px; background: linear-gradient(135deg, #3763eb 0%, #6f58e8 100%);">
                  <i class="lni lni-lock fs-4"></i>
                </div>
              </div>
              <div class="col">
                <h4 class="h5 fw-bold text-dark mb-1">Integrity & Absolute Transparency</h4>
                <p class="text-secondary mb-0 small">Ethical contracting, honest material specifications, and crystal-clear progress updates form the foundation of our client relationships.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 wow fadeInUp" data-wow-delay=".4s">
            <div class="row align-items-center g-3">
              <div class="col-auto">
                <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 52px; height: 52px; background: linear-gradient(135deg, #3763eb 0%, #6f58e8 100%);">
                  <i class="lni lni-rocket fs-4"></i>
                </div>
              </div>
              <div class="col">
                <h4 class="h5 fw-bold text-dark mb-1">Adaptability & Rapid Deployment</h4>
                <p class="text-secondary mb-0 small">Quickly adapting to evolving site demands, regulatory grid codes, and custom architectural requirements without compromise.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Callout Banner -->
  <section id="connect" class="py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">Partner With Excellence</span>
      <h2 class="display-5 fw-bold text-white mb-3">Experience Unmatched Service Quality</h2>
      <p class="lead text-white-50 max-w-xl mx-auto mb-4">
        Let GlobSol handle your next civil construction, 33kV substation, or turnkey solar EPC project with complete confidence.
      </p>
      <div class="d-flex justify-content-center align-items-center flex-wrap gap-3">
        <a href="/contact" class="btn btn-light btn-lg fw-bold text-primary px-4 rounded-pill shadow-sm">Contact Our Engineers</a>
        <a href="/services" class="btn btn-outline-light btn-lg fw-bold px-4 rounded-pill">Explore Services</a>
      </div>
    </div>
  </section>
</BaseLayout>
