---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClientLogoSection from '../../components/ClientLogoSection.astro';
---

<BaseLayout 
  title="About Us | GlobSol Power Pvt Ltd"
  description="Learn about GlobSol Power Pvt Ltd - Civil Construction, Class 1 Government Electrical Contracting up to 33kV, and Solar PV EPC specialists in India."
>
  <!-- Page Banner Section -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8 mx-auto">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">About GlobSol</span>
          <h1 class="display-4 fw-bold text-white mb-3">Powering India with Engineering Excellence</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-0">
            Civil Construction, Class 1 Government Licensed Electrical Contractors up to 33kV, & Turnkey Solar PV EPC Solutions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 1. Who We Are Section -->
  <section id="who-we-are" class="py-5 bg-white">
    <div class="container">
      <div class="row">
        <div class="col-xl-9 col-lg-10 mx-auto text-center">
          <div class="section-title text-center mb-4">
            <span class="wow fadeInUp" data-wow-delay=".2s">Who We Are</span>
            <h2 class="mb-3 wow fadeInUp" data-wow-delay=".4s">Civil & Class 1 Government-Licensed Contracting</h2>
          </div>
          <div class="about-content">
            <p class="mb-3 wow fadeInUp text-secondary" data-wow-delay=".5s">We proudly introduce ourselves as Civil & Class 1 Government-licensed Electrical Contractors specializing in Construction, Electrical Installation up to 33kV, and Solar PV EPC (both on-grid and off-grid). Equipped with modern tools and technical knowledge, our skilled team executes complex electrification and building projects across India.</p>
            <p class="mb-4 wow fadeInUp text-secondary" data-wow-delay=".6s">We excel in residential & commercial construction, operating substations up to 33kV, managing DG sets, and executing turnkey solar projects for leading organizations including BEL, HAL, HMT, Hitachi, and Rosetta Hospitality.</p>
          </div>
        </div>
      </div>

      <!-- 4 Core Expertise Boxes -->
      <div class="row g-4 mt-2">
        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-light rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".2s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fs-4 mx-auto mb-3">
              <i class="lni lni-bolt"></i>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">33kV High Voltage</h4>
              <p class="text-secondary small mb-0">HT/LT substations, power distribution & transformer erection up to 33kV.</p>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-light rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".4s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fs-4 mx-auto mb-3">
              <i class="lni lni-sun"></i>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">Turnkey Solar EPC</h4>
              <p class="text-secondary small mb-0">Megawatt scale rooftop and ground-mounted solar power plants.</p>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-light rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".6s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fs-4 mx-auto mb-3">
              <i class="lni lni-layout"></i>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">Civil Construction</h4>
              <p class="text-secondary small mb-0">Industrial facilities, residential buildings, and luxury interior fit-outs.</p>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-light rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".8s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fs-4 mx-auto mb-3">
              <i class="lni lni-shield"></i>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">CEIG Compliant</h4>
              <p class="text-secondary small mb-0">100% statutory approvals, safety audits, and grid clearances.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Our Journey Section -->
  <section id="our-journey" class="py-5 bg-light">
    <div class="container">
      <div class="row">
        <div class="col-xl-6 col-lg-7 col-md-9 mx-auto">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInDown" data-wow-delay=".2s">Milestones</span>
            <h2 class="wow fadeInUp" data-wow-delay=".4s">Our Journey & Growth</h2>
            <p class="wow fadeInUp text-secondary" data-wow-delay=".6s">A legacy of engineering excellence built through continuous innovation and quality execution.</p>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-white rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".2s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5 mx-auto mb-3">
              <span>2020</span>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">Founding & Class-1 License</h4>
              <p class="text-secondary small mb-0">Established GlobSol Power Pvt Ltd, securing Class 1 Government Electrical Contracting license up to 33kV.</p>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-white rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".4s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5 mx-auto mb-3">
              <span>2021</span>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">Defense & PSU Contracts</h4>
              <p class="text-secondary small mb-0">Awarded high-voltage electrical contracts by premier defense enterprises BEL, HAL, and HMT.</p>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-white rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".6s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5 mx-auto mb-3">
              <span>2022</span>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">Solar EPC Division</h4>
              <p class="text-secondary small mb-0">Launched turnkey solar PV EPC division, executing rooftop & ground-mount clean energy plants.</p>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style text-center h-100 p-4 bg-white rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay=".8s">
            <div class="feature-icon box-icon-style icon-box-lg icon-gradient-bg rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5 mx-auto mb-3">
              <span>2024+</span>
            </div>
            <div class="box-content-style feature-content">
              <h4 class="fw-bold fs-5 mb-2">100+ Delivered Projects</h4>
              <p class="text-secondary small mb-0">Crossed 100+ completed projects, expanding into civil infrastructure, Rosetta Hospitality fit-outs, and smart grids.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Our Impact & Recognition Section -->
  <section id="impact" class="py-5 bg-white">
    <div class="container">
      <div class="row">
        <div class="col-xl-6 col-lg-7 col-md-9 mx-auto">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInDown" data-wow-delay=".2s">Impact</span>
            <h2 class="wow fadeInUp" data-wow-delay=".4s">Our Impact & Recognition</h2>
            <p class="wow fadeInUp text-secondary" data-wow-delay=".6s">Delivering proven engineering quality across public sector undertakings and premier corporations.</p>
          </div>
        </div>
      </div>

      <!-- 3 Primary Cards -->
      <div class="row g-4 mb-5 justify-content-center">
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">33kV</h3>
            <h4 class="h5 text-white fw-bold mb-2">High Voltage Rating</h4>
            <p class="small text-white-50 mb-0">HT/LT Substations, Transformers & Power Distribution</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">100+</h3>
            <h4 class="h5 text-white fw-bold mb-2">Projects Delivered</h4>
            <p class="small text-white-50 mb-0">Turnkey Civil, Electrical Contracting & Solar PV EPC</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">100%</h3>
            <h4 class="h5 text-white fw-bold mb-2">CEIG Compliance</h4>
            <p class="small text-white-50 mb-0">Government Approved Electrical Safety Clearances</p>
          </div>
        </div>
      </div>

      <!-- Client Partner Carousel -->
      <ClientLogoSection />
    </div>
  </section>

  <!-- 4. Connect With Us Section -->
  <section id="connect" class="py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">Partner With Us</span>
      <h2 class="display-5 fw-bold text-white mb-3">Ready to Power Your Next Project?</h2>
      <p class="lead text-white-50 max-w-xl mx-auto mb-4">
        Get in touch with our engineering team for civil construction, 33kV electrical contracting, or solar EPC solutions.
      </p>
      <div class="d-flex justify-content-center align-items-center flex-wrap gap-3">
        <a href="/contact" class="btn btn-light btn-lg fw-bold text-primary px-4 rounded-pill shadow-sm">Get in Touch</a>
        <a href="/services" class="btn btn-outline-light btn-lg fw-bold px-4 rounded-pill">Our Services</a>
      </div>
    </div>
  </section>
</BaseLayout>
