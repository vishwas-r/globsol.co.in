---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClientLogoSection from '../../components/ClientLogoSection.astro';
---

<BaseLayout 
  title="About Us | GlobSol Power Pvt Ltd"
  description="Learn about GlobSol Power Pvt Ltd - Civil Construction, Class 1 Government Electrical Contracting up to 33kV, and Solar PV EPC specialists in India."
>
  <!-- Page Banner Section -->
  <section class="page-banner-section pt-110 pb-50" style="background: linear-gradient(135deg, #1e73be 0%, #0c4a85 50%, #072d52 100%);">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8 mx-auto text-center text-white">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm" style="color: #1e73be !important;">About GlobSol</span>
          <h1 class="display-4 fw-bold text-white mb-3" style="letter-spacing: -1px;">Powering India with Engineering Excellence</h1>
          <p class="lead max-w-xl mx-auto mb-0" style="font-size: 1.15rem; color: rgba(255,255,255,0.88) !important;">
            Civil Construction, Class 1 Government Licensed Electrical Contractors up to 33kV, & Turnkey Solar PV EPC Solutions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 1. Who We Are Section -->
  <section id="who-we-are">
    <div class="about-section">
      <div class="container">
        <div class="row">
          <div class="col-xl-9 col-lg-10 mx-auto text-center">
            <div class="section-title text-center mb-30">
              <span class="wow fadeInUp" data-wow-delay=".2s">Who We Are</span>
              <h2 class="mb-20 wow fadeInUp" data-wow-delay=".4s">Civil & Class 1 Government-Licensed Contracting</h2>
            </div>
            <div class="about-content">
              <p class="mb-20 wow fadeInUp" data-wow-delay=".5s">We proudly introduce ourselves as Civil & Class 1 Government-licensed Electrical Contractors specializing in Construction, Electrical Installation up to 33kV, and Solar PV EPC (both on-grid and off-grid). Equipped with modern tools and technical knowledge, our skilled team executes complex electrification and building projects across India.</p>
              <p class="mb-30 wow fadeInUp" data-wow-delay=".6s">We excel in residential & commercial construction, operating substations up to 33kV, managing DG sets, and executing turnkey solar projects for leading organizations including BEL, HAL, HMT, Hitachi, and Rosetta Hospitality.</p>
            </div>
          </div>
        </div>

        <!-- 4 Core Expertise Boxes across full width -->
        <div class="row mt-40">
          <div class="col-lg-3 col-md-6">
            <div class="feature-box box-style mb-30 text-center wow fadeInUp" data-wow-delay=".2s">
              <div class="feature-icon box-icon-style mx-auto">
                <i class="lni lni-bolt"></i>
              </div>
              <div class="box-content-style feature-content">
                <h4>33kV High Voltage</h4>
                <p>HT/LT substations, power distribution & transformer erection up to 33kV.</p>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="feature-box box-style mb-30 text-center wow fadeInUp" data-wow-delay=".4s">
              <div class="feature-icon box-icon-style mx-auto">
                <i class="lni lni-sun"></i>
              </div>
              <div class="box-content-style feature-content">
                <h4>Turnkey Solar EPC</h4>
                <p>Megawatt scale rooftop and ground-mounted solar power plants.</p>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="feature-box box-style mb-30 text-center wow fadeInUp" data-wow-delay=".6s">
              <div class="feature-icon box-icon-style mx-auto">
                <i class="lni lni-layout"></i>
              </div>
              <div class="box-content-style feature-content">
                <h4>Civil Construction</h4>
                <p>Industrial facilities, residential buildings, and luxury interior fit-outs.</p>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="feature-box box-style mb-30 text-center wow fadeInUp" data-wow-delay=".8s">
              <div class="feature-icon box-icon-style mx-auto">
                <i class="lni lni-shield"></i>
              </div>
              <div class="box-content-style feature-content">
                <h4>CEIG Compliant</h4>
                <p>100% statutory approvals, safety audits, and grid clearances.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Our Journey Section -->
  <section id="our-journey" class="feature-section pt-100 pb-100 img-bg" style="background-color: #f8f9fa;">
    <div class="container">
      <div class="row">
        <div class="col-xl-6 col-lg-7 col-md-9 mx-auto">
          <div class="section-title text-center mb-60">
            <span class="wow fadeInDown" data-wow-delay=".2s">Milestones</span>
            <h2 class="wow fadeInUp" data-wow-delay=".4s">Our Journey & Growth</h2>
            <p class="wow fadeInUp" data-wow-delay=".6s">A legacy of engineering excellence built through continuous innovation and quality execution.</p>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style mb-30 wow fadeInUp" data-wow-delay=".2s">
            <div class="feature-icon box-icon-style">
              <span>2020</span>
            </div>
            <div class="box-content-style feature-content">
              <h4>Founding & Class-1 License</h4>
              <p>Established GlobSol Power Pvt Ltd, securing Class 1 Government Electrical Contracting license up to 33kV.</p>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style mb-30 wow fadeInUp" data-wow-delay=".4s">
            <div class="feature-icon box-icon-style">
              <span>2021</span>
            </div>
            <div class="box-content-style feature-content">
              <h4>Defense & PSU Contracts</h4>
              <p>Awarded high-voltage electrical contracts by premier defense enterprises BEL, HAL, and HMT.</p>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style mb-30 wow fadeInUp" data-wow-delay=".6s">
            <div class="feature-icon box-icon-style">
              <span>2022</span>
            </div>
            <div class="box-content-style feature-content">
              <h4>Solar EPC Division</h4>
              <p>Launched turnkey solar PV EPC division, executing rooftop & ground-mount clean energy plants.</p>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-box box-style mb-30 wow fadeInUp" data-wow-delay=".8s">
            <div class="feature-icon box-icon-style">
              <span>2024+</span>
            </div>
            <div class="box-content-style feature-content">
              <h4>100+ Delivered Projects</h4>
              <p>Crossed 100+ completed projects, expanding into civil infrastructure, Rosetta Hospitality fit-outs, and smart grids.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Meet Our Leadership Section -->
  <section id="leadership" class="team-section pt-100 pb-100">
    <div class="container">
      <div class="row">
        <div class="col-xl-6 col-lg-7 col-md-9 mx-auto">
          <div class="section-title text-center mb-60">
            <span class="wow fadeInDown" data-wow-delay=".2s">Leadership</span>
            <h2 class="wow fadeInUp" data-wow-delay=".4s">Meet Our Leadership</h2>
            <p class="wow fadeInUp" data-wow-delay=".6s">Experienced electrical & civil engineers driving GlobSol's commitment to safety and excellence.</p>
          </div>
        </div>
      </div>

      <div class="row justify-content-center">
        <div class="col-xl-4 col-lg-4 col-md-6">
          <div class="single-team text-center mb-40 wow fadeInUp" data-wow-delay=".2s">
            <div class="team-img">
              <img src="/assets/img/team/team-1.jpg" alt="Managing Director">
              <div class="team-social">
                <ul>
                  <li><a href="javascript:void(0)"><i class="lni lni-linkedin-original"></i></a></li>
                  <li><a href="javascript:void(0)"><i class="lni lni-envelope"></i></a></li>
                </ul>
              </div>
            </div>
            <div class="team-info">
              <h4>Managing Director</h4>
              <span>Chief Electrical Engineer (33kV)</span>
            </div>
          </div>
        </div>

        <div class="col-xl-4 col-lg-4 col-md-6">
          <div class="single-team text-center mb-40 wow fadeInUp" data-wow-delay=".4s">
            <div class="team-img">
              <img src="/assets/img/team/team-2.jpg" alt="Head of Civil Engineering">
              <div class="team-social">
                <ul>
                  <li><a href="javascript:void(0)"><i class="lni lni-linkedin-original"></i></a></li>
                  <li><a href="javascript:void(0)"><i class="lni lni-envelope"></i></a></li>
                </ul>
              </div>
            </div>
            <div class="team-info">
              <h4>Head of Civil Engineering</h4>
              <span>Structural & Architectural Lead</span>
            </div>
          </div>
        </div>

        <div class="col-xl-4 col-lg-4 col-md-6">
          <div class="single-team text-center mb-40 wow fadeInUp" data-wow-delay=".6s">
            <div class="team-img">
              <img src="/assets/img/team/team-3.jpg" alt="Lead Solar EPC Consultant">
              <div class="team-social">
                <ul>
                  <li><a href="javascript:void(0)"><i class="lni lni-linkedin-original"></i></a></li>
                  <li><a href="javascript:void(0)"><i class="lni lni-envelope"></i></a></li>
                </ul>
              </div>
            </div>
            <div class="team-info">
              <h4>Lead Solar EPC Consultant</h4>
              <span>Renewable Energy Specialist</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Our Impact & Recognition Section -->
  <section id="impact" class="pt-100 pb-80 img-bg" style="background-color: #f8f9fa;">
    <div class="container">
      <div class="row">
        <div class="col-xl-6 col-lg-7 col-md-9 mx-auto">
          <div class="section-title text-center mb-60">
            <span class="wow fadeInDown" data-wow-delay=".2s">Impact</span>
            <h2 class="wow fadeInUp" data-wow-delay=".4s">Our Impact & Recognition</h2>
            <p class="wow fadeInUp" data-wow-delay=".6s">Delivering proven engineering quality across public sector undertakings and premier corporations.</p>
          </div>
        </div>
      </div>

      <!-- 3 Primary Cards with White Text -->
      <div class="row g-4 mb-60 justify-content-center">
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100" style="background: linear-gradient(135deg, #1e73be 0%, #0d4b82 100%);">
            <h3 class="display-4 fw-bold text-white mb-2">33kV</h3>
            <h4 class="h5 text-white fw-bold mb-2">High Voltage Rating</h4>
            <p class="small mb-0" style="color: rgba(255,255,255,0.85) !important;">HT/LT Substations, Transformers & Power Distribution</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100" style="background: linear-gradient(135deg, #1e73be 0%, #0d4b82 100%);">
            <h3 class="display-4 fw-bold text-white mb-2">100+</h3>
            <h4 class="h5 text-white fw-bold mb-2">Projects Delivered</h4>
            <p class="small mb-0" style="color: rgba(255,255,255,0.85) !important;">Turnkey Civil, Electrical Contracting & Solar PV EPC</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100" style="background: linear-gradient(135deg, #1e73be 0%, #0d4b82 100%);">
            <h3 class="display-4 fw-bold text-white mb-2">100%</h3>
            <h4 class="h5 text-white fw-bold mb-2">CEIG Compliance</h4>
            <p class="small mb-0" style="color: rgba(255,255,255,0.85) !important;">Government Approved Electrical Safety Clearances</p>
          </div>
        </div>
      </div>

      <!-- Client Partner Carousel -->
      <ClientLogoSection />
    </div>
  </section>

  <!-- 5. Connect With Us Section (Full Width Background) -->
  <section id="connect" style="padding: 100px 0; background: linear-gradient(135deg, #1e73be 0%, #0c4a85 50%, #072d52 100%);">
    <div class="container text-white text-center">
      <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm" style="color: #1e73be !important;">Partner With Us</span>
      <h2 class="display-5 fw-bold text-white mb-3">Ready to Power Your Next Project?</h2>
      <p class="lead max-w-xl mx-auto mb-4" style="color: rgba(255,255,255,0.88) !important; max-width: 650px;">
        Get in touch with our engineering team for civil construction, 33kV electrical contracting, or solar EPC solutions.
      </p>
      <div class="d-flex justify-content-center align-items-center flex-wrap" style="gap: 16px;">
        <a href="/contact" class="btn btn-light btn-lg fw-bold text-primary px-4 rounded-pill shadow-sm" style="color: #1e73be !important; background-color: #ffffff !important; margin-right: 12px;">Get in Touch</a>
        <a href="/services" class="btn btn-outline-light btn-lg fw-bold px-4 rounded-pill">Our Services</a>
      </div>
    </div>
  </section>
</BaseLayout>
