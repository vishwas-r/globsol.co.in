---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClientLogoSection from '../../components/ClientLogoSection.astro';
import Testimonials from '../../components/Testimonials.astro';
import ContactSection from '../../components/ContactSection.astro';

const baseUrl = import.meta.env.BASE_URL;

const clientsList = [
  {
    name: "Bharat Electronics Limited",
    abbr: "BEL",
    logo: `${baseUrl}assets/img/client-logo/bharat-electronics.png`,
    description: "High-voltage 33kV electrical contracting, HT transformer installations, and power distribution systems."
  },
  {
    name: "Hindustan Aeronautics Limited",
    abbr: "HAL",
    logo: `${baseUrl}assets/img/client-logo/hal.png`,
    description: "Defense facility industrial electrical maintenance, substation operations, and infrastructure contracting."
  },
  {
    name: "HMT Limited",
    abbr: "HMT",
    logo: `${baseUrl}assets/img/client-logo/hmt.png`,
    description: "Industrial logistics, heavy equipment handling, and high-capacity electrical distribution network setups."
  },
  {
    name: "Hitachi",
    abbr: "Hitachi",
    logo: `${baseUrl}assets/img/client-logo/hitachi.png`,
    description: "Commercial facility electrical contracting and turnkey solar PV rooftop EPC installations."
  },
  {
    name: "Janani Water Technologies",
    abbr: "Janani",
    logo: `${baseUrl}assets/img/client-logo/janani.png`,
    description: "Turnkey electrical contracting, power panel engineering, and facility wiring works."
  },
  {
    name: "Rosetta Hospitality",
    abbr: "Rosetta",
    logo: `${baseUrl}assets/img/client-logo/rosetta-hospitality.png`,
    description: "Facility logistics support, aesthetic lighting, and specialized electrical execution."
  }
];
---

<BaseLayout 
  title="Our Happy Clients | GlobSol Power Pvt Ltd"
  description="Trusted by Bharat Electronics, HAL, HMT, Hitachi, Janani, and Rosetta Hospitality."
>
  <!-- Page Banner Section -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8 mx-auto">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">Client Trust</span>
          <h1 class="display-4 fw-bold text-white mb-3">Our Valued Clients</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-0">
            Trusted Partnerships Across Government Defense Undertakings & Industry Leaders
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Animated Logo Banner -->
  <ClientLogoSection />

  <!-- Client Grid Section -->
  <section class="py-5 bg-light">
    <div class="container">
      <div class="row">
        <div class="col-xl-9 col-lg-10 mx-auto text-center">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInUp" data-wow-delay=".2s">Track Record of Trust</span>
            <h2 class="mb-3 wow fadeInUp" data-wow-delay=".4s">Prestigious Client Roster</h2>
            <p class="wow fadeInUp text-secondary" data-wow-delay=".5s">Having successfully served leading Public Sector Undertakings (PSUs) and premier commercial enterprises across India, we take pride in our long-lasting client relationships.</p>
          </div>
        </div>
      </div>

      <div class="row g-4">
        {clientsList.map((client, index) => (
          <div class="col-lg-4 col-md-6">
            <div class="feature-box box-style mb-4 text-center h-100 p-4 bg-white rounded-4 shadow-sm border-0 wow fadeInUp" data-wow-delay={`${0.2 * (index % 3 + 1)}s`}>
              <div class="p-3 mb-3 bg-light rounded-3 d-flex align-items-center justify-content-center mx-auto" style="height: 70px; max-width: 180px;">
                <img src={client.logo} alt={client.name} class="mw-100 mh-100 object-fit-contain" />
              </div>
              <div class="box-content-style feature-content">
                <h4 class="fw-bold fs-5 text-dark mb-2">{client.name}</h4>
                <p class="text-secondary small mb-0">{client.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <Testimonials />

  <!-- Full-Width Contact Callout Banner -->
  <ContactSection />
</BaseLayout>
