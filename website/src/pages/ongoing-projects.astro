---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';

const baseUrl = import.meta.env.BASE_URL;

const ongoingProjects = [
  {
    id: "rosetta-resorts-kalyapura",
    title: "Rosetta Resorts, Kalyapura",
    subtitle: "Ferns Forest View Luxury Destination",
    category: "Luxury Resort Electrification & Substation",
    date: "Under Execution",
    cover: `${baseUrl}assets/img/projects/project-placeholder.svg`,
    description: "Turnkey electrical infrastructure, high-capacity substation erection, underground power cable trenching, distribution boards, and landscape aesthetic illumination across the 10-acre luxury resort campus.",
    gallery: []
  }
];
---

<BaseLayout 
  title="Ongoing Projects | GlobSol Power Pvt Ltd"
  description="Explore current ongoing 33kV electrical contracting, substation electrification, and solar PV EPC developments managed by GlobSol Power Pvt Ltd."
>
  <!-- Banner -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">Under Execution</span>
          <h1 class="display-4 fw-bold text-white mb-3">Ongoing Projects</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-4">
            Active Infrastructure & Electrification Engineering Developments Across India
          </p>
          <!-- Project Category Navigation Pills -->
          <div class="d-inline-flex p-1 rounded-pill shadow-sm" style="background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(8px);">
            <a href={`${baseUrl}completed-projects`} class="btn btn-sm text-white text-decoration-none rounded-pill px-4 py-2 fw-semibold"><i class="lni lni-arrow-left me-1"></i> Completed Projects</a>
            <span class="btn btn-sm btn-light rounded-pill px-4 py-2 fw-bold text-primary shadow-sm">Ongoing Projects</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ongoing Projects Grid / Empty State -->
  <section class="py-5 bg-light">
    <div class="container">
      {ongoingProjects.length > 0 ? (
        <div class="row g-4 justify-content-center">
          {ongoingProjects.map((project) => (
            <div class="col-lg-6 col-md-12">
              <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-img-container position-relative overflow-hidden" style="height: 260px;">
                  <a href={project.cover} class="glightbox d-block w-100 h-100" data-gallery={project.id} title={project.title}>
                    <img 
                      src={project.cover} 
                      alt={project.title} 
                      class="w-100 h-100 object-fit-cover transition-all" 
                    />
                  </a>
                  <span class="position-absolute top-0 end-0 m-3 badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm fw-bold">
                    In Progress
                  </span>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                  <div>
                    <span class="text-primary fw-bold text-uppercase small tracking-wider">{project.category}</span>
                    <h3 class="h4 fw-bold text-dark mt-1 mb-2">{project.title}</h3>
                    <p class="text-secondary mb-4">{project.description}</p>
                  </div>

                  <div>
                    <h6 class="fw-bold small text-secondary mb-2">Photo Gallery</h6>
                    <div class="d-flex gap-2 flex-wrap">
                      {project.gallery.map((imgUrl, index) => (
                        <a href={imgUrl} class="glightbox rounded-3 overflow-hidden shadow-sm d-inline-block" data-gallery={project.id} title={`${project.title} - Photo ${index + 1}`}>
                          <img src={imgUrl} alt={`${project.title} gallery thumbnail ${index + 1}`} class="thumb-img" />
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Link to Completed Projects -->
        <div class="row mt-5">
          <div class="col-lg-8 mx-auto text-center">
            <div class="p-4 bg-white rounded-4 shadow-sm border border-light">
              <h5 class="fw-bold text-dark mb-2">Looking for our delivered project record?</h5>
              <p class="text-secondary small mb-3">Explore our completed portfolio of 33kV electrical contracting, turnkey solar PV EPC, and facility power installations.</p>
              <a href={`${baseUrl}completed-projects`} class="btn btn-outline-primary px-4 py-2 rounded-pill fw-bold">
                <i class="lni lni-arrow-left me-1"></i> View Completed Projects
              </a>
            </div>
          </div>
        </div>
      ) : (
        <div class="row justify-content-center py-4">
          <div class="col-lg-8 text-center">
            <div class="p-5 bg-white rounded-4 shadow-sm border-0">
              <div class="rounded-circle bg-light text-primary d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px; background: linear-gradient(135deg, #e0e7ff 0%, #f1f5f9 100%);">
                <i class="lni lni-construction-hammer fs-1 text-primary"></i>
              </div>
              <h3 class="h4 fw-bold text-dark mb-2">No Active Projects Under Execution</h3>
              <p class="text-secondary mb-4 max-w-lg mx-auto">We are currently preparing for new site deployments. Explore our track record of completed projects or reach out to discuss upcoming contracting opportunities.</p>
              <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href={`${baseUrl}completed-projects`} class="btn btn-primary px-4 py-2.5 rounded-pill fw-bold shadow-sm">View Completed Projects</a>
                <a href={`${baseUrl}contact`} class="btn btn-outline-primary px-4 py-2.5 rounded-pill fw-bold">Contact Our Engineers</a>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <ContactSection />
</BaseLayout>
