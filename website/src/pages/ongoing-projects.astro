---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';

const ongoingProjects = [
  {
    id: "mr-peter-vidyaranyapura",
    title: "Mr. Peter, Vidyaranyapura",
    category: "Residential Civil Construction & Electrical Contracting",
    date: "Active Project (Started Aug 2024)",
    cover: "/assets/img/projects/peter-vidyaranyapura/5.jpeg",
    description: "Ongoing full-scale residential building construction and internal electrical distribution work located in Vidyaranyapura, Bengaluru.",
    gallery: [
      "/assets/img/projects/peter-vidyaranyapura/5.jpeg",
      "/assets/img/projects/peter-vidyaranyapura/1.jpeg",
      "/assets/img/projects/peter-vidyaranyapura/2.jpeg",
      "/assets/img/projects/peter-vidyaranyapura/3.jpeg",
      "/assets/img/projects/peter-vidyaranyapura/4.jpeg",
      "/assets/img/projects/peter-vidyaranyapura/6.jpeg",
      "/assets/img/projects/peter-vidyaranyapura/7.jpeg",
      "/assets/img/projects/peter-vidyaranyapura/8.jpeg",
      "/assets/img/projects/peter-vidyaranyapura/9.jpeg",
      "/assets/img/projects/peter-vidyaranyapura/10.jpeg",
      "/assets/img/projects/peter-vidyaranyapura/11.jpeg",
      "/assets/img/projects/peter-vidyaranyapura/12.jpeg"
    ]
  },
  {
    id: "roshan-residency-hennur",
    title: "Mr. Roshan Residency, Hennur",
    category: "Civil Construction & Structural Engineering",
    date: "Active Project (Started Apr 2024)",
    cover: "/assets/img/projects/roshan-residency/20240203_181938.jpg",
    description: "Multi-story residential development under active execution, including structural work, masonry, and foundational electrical installation in Hennur, Bengaluru.",
    gallery: [
      "/assets/img/projects/roshan-residency/20240203_181938.jpg",
      "/assets/img/projects/roshan-residency/20240129_114431.jpg",
      "/assets/img/projects/roshan-residency/20240129_110932.jpg",
      "/assets/img/projects/roshan-residency/20240129_110928.jpg",
      "/assets/img/projects/roshan-residency/20240129_115007.jpg",
      "/assets/img/projects/roshan-residency/20240129_113622.jpg"
    ]
  }
];
---

<BaseLayout 
  title="Ongoing Projects | GlobSol Power Pvt Ltd"
  description="Explore current ongoing civil construction, 33kV electrical contracting, and solar PV EPC developments managed by GlobSol Power Pvt Ltd."
>
  <!-- Banner -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container py-4">
      <div class="row">
        <div class="col-lg-12">
          <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">Under Execution</span>
          <h1 class="display-4 fw-bold text-white mb-3">Ongoing Projects</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-0">
            Active Infrastructure & Electrification Engineering Developments Across India
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ongoing Projects Grid -->
  <section class="py-5 bg-light">
    <div class="container py-4">
      <div class="row g-4">
        {ongoingProjects.map((project) => (
          <div class="col-lg-6 col-md-12">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white">
              <div class="card-img-container">
                <a href={project.cover} class="glightbox" data-gallery={project.id} title={project.title}>
                  <img 
                    src={project.cover} 
                    alt={project.title} 
                    class="w-100 h-100 object-fit-cover transition-all" 
                  />
                </a>
                <span class="position-absolute top-0 end-0 m-3 badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm fw-bold">
                  In Progress
                </span>
              </div>
              <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div>
                  <span class="text-primary fw-bold text-uppercase small tracking-wider">{project.category}</span>
                  <h3 class="h4 fw-bold text-dark mt-1 mb-2">{project.title}</h3>
                  <p class="text-secondary mb-4">{project.description}</p>
                </div>

                <div>
                  <h5 class="fw-bold fs-6 text-dark mb-3">Progress Photo Gallery (Click to Expand):</h5>
                  <div class="d-flex gap-2 flex-wrap">
                    {project.gallery.map((imgUrl, index) => (
                      <a href={imgUrl} class="glightbox rounded-3 overflow-hidden shadow-sm d-inline-block" data-gallery={project.id} title={`${project.title} - Photo ${index + 1}`}>
                        <img src={imgUrl} alt={`${project.title} gallery thumbnail ${index + 1}`} class="thumb-img" />
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <ContactSection />
</BaseLayout>
