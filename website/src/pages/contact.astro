---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact Us | GlobSol Power Pvt Ltd"
  description="Contact GlobSol Power Pvt Ltd for industrial logistics, technical manpower supply, Class 1 electrical contracting up to 33kV, and turnkey solar PV EPC solutions across India."
>
  <!-- Page Banner Section (Matching About Us Design) -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8 mx-auto">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">Get In Touch</span>
          <h1 class="display-4 fw-bold text-white mb-3">Contact GlobSol</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-0">
            Have an industrial logistics, technical manpower, high-voltage electrical (33kV), or solar PV project in mind? Reach out to our engineering team.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Contact Section -->
  <section class="py-5 bg-light">
    <div class="container">
      <div class="row g-4 align-items-start">
        <!-- Left Info Column -->
        <div class="col-lg-5">
          <div class="pe-lg-4">
            <div class="section-title mb-4">
              <span class="text-primary fw-bold text-uppercase tracking-wider small d-block mb-1">Engineering Consultation</span>
              <h2 class="h3 fw-bold text-dark mb-3">Let's Build Something Great</h2>
              <p class="text-secondary">
                Fill out the project inquiry form or reach us directly. Our engineering leads respond to all commercial and government RFPs within 24 business hours.
              </p>
            </div>

            <div class="d-flex flex-column gap-3 mb-4">
              <!-- Email Card -->
              <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="row align-items-center g-3">
                  <div class="col-auto">
                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm bg-gs-gradient" style="width: 52px; height: 52px;">
                      <i class="lni lni-envelope fs-4"></i>
                    </div>
                  </div>
                  <div class="col">
                    <div class="text-secondary small fw-semibold mb-1">Email Us Directly</div>
                    <div>
                      <a href="mailto:info@globsol.co.in" class="fw-bold text-primary text-decoration-none fs-6">info@globsol.co.in</a>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Statutory Licensing Card -->
              <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="row align-items-center g-3">
                  <div class="col-auto">
                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm bg-gs-gradient" style="width: 52px; height: 52px;">
                      <i class="lni lni-shield fs-4"></i>
                    </div>
                  </div>
                  <div class="col">
                    <div class="text-secondary small fw-semibold mb-1">Statutory Licensing</div>
                    <div class="fw-bold text-dark fs-6">Class 1 Electrical License (Up to 33kV)</div>
                  </div>
                </div>
              </div>

              <!-- Operational Reach Card -->
              <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="row align-items-center g-3">
                  <div class="col-auto">
                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm bg-gs-gradient" style="width: 52px; height: 52px;">
                      <i class="lni lni-map-marker fs-4"></i>
                    </div>
                  </div>
                  <div class="col">
                    <div class="text-secondary small fw-semibold mb-1">Operational Reach</div>
                    <div class="fw-bold text-dark fs-6">Pan-India Execution (Civil, Electrical & Solar)</div>
                  </div>
                </div>
              </div>

              <!-- Social Media Channels Card -->
              <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="row align-items-center g-3">
                  <div class="col-auto">
                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm bg-gs-gradient" style="width: 52px; height: 52px;">
                      <i class="lni lni-share fs-4"></i>
                    </div>
                  </div>
                  <div class="col">
                    <div class="text-secondary small fw-semibold mb-1">Follow Our Channels</div>
                    <div class="d-flex align-items-center gap-3 mt-1">
                      <a href="https://www.facebook.com/GSPPL2020/" target="_blank" rel="noopener noreferrer" class="text-primary text-decoration-none fw-semibold d-inline-flex align-items-center gap-1">
                        <i class="lni lni-facebook-filled fs-5"></i> Facebook
                      </a>
                      <span class="text-muted">•</span>
                      <a href="https://www.instagram.com/globsolpower/" target="_blank" rel="noopener noreferrer" class="text-danger text-decoration-none fw-semibold d-inline-flex align-items-center gap-1">
                        <i class="lni lni-instagram-filled fs-5"></i> Instagram
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Form Column -->
        <div class="col-lg-7">
          <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-4 p-md-5">
            <h3 class="h4 fw-bold text-dark mb-2">Request Project Estimate</h3>
            <p class="text-secondary small mb-4">Share your technical scope, site specifications, or inquiry details below.</p>
            
            <!-- Formspree Endpoint Form -->
            <form action="https://formspree.io/f/xbjnqkyz" method="POST">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label small fw-bold text-dark">Your Full Name *</label>
                  <input type="text" name="name" class="form-control form-control-lg fs-6 rounded-3" placeholder="e.g. Rajesh Kumar" required />
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-bold text-dark">Corporate / Personal Email *</label>
                  <input type="email" name="email" class="form-control form-control-lg fs-6 rounded-3" placeholder="e.g. rajesh@company.com" required />
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-bold text-dark">Phone Number</label>
                  <input type="tel" name="phone" class="form-control form-control-lg fs-6 rounded-3" placeholder="+91 98765 43210" />
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-bold text-dark">Required Service Area</label>
                  <select name="service" class="form-select form-select-lg fs-6 rounded-3">
                    <option value="Electrical Contractor">Class 1 Electrical Contracting (Up to 33kV)</option>
                    <option value="Solar EPC">Solar PV EPC Solutions & AMC</option>
                    <option value="Logistics & Manpower">Industrial Logistics & Technical Manpower Supply</option>
                    <option value="General Inquiry">General Commercial Inquiry</option>
                  </select>
                </div>
                <div class="col-12">
                  <label class="form-label small fw-bold text-dark">Project Details / Message Scope *</label>
                  <textarea name="message" rows="4" class="form-control form-control-lg fs-6 rounded-3" placeholder="Provide project location, voltage rating, MW size, or civil layout requirements..." required></textarea>
                </div>
                <div class="col-12 mt-4">
                  <button type="submit" class="btn btn-lg w-100 py-3 rounded-pill fw-bold text-white shadow-sm bg-gs-gradient border-0">
                    Submit Inquiry <i class="lni lni-arrow-right ms-2"></i>
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
