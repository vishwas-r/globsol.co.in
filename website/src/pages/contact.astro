---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact Us | GlobSol Power Pvt Ltd"
  description="Contact GlobSol Power Pvt Ltd for Class 1 licensed electrical contracting up to 33kV, turnkey solar PV EPC & AMC solutions, and industrial logistics & technical manpower supply across South India."
>
  <!-- Page Banner Section (Matching About Us Design) -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8 mx-auto">
          <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 mb-3">
            <span class="badge bg-white text-primary px-2.5 py-1 rounded-pill fw-bold text-uppercase shadow-sm" style="font-size: 0.72rem; letter-spacing: 0.5px; line-height: 1.2;">Get In Touch</span>
            <span class="badge text-white px-2.5 py-1 rounded-pill fw-semibold shadow-sm" style="background: rgba(255, 255, 255, 0.16); border: 1px solid rgba(255, 255, 255, 0.35); backdrop-filter: blur(6px); font-size: 0.75rem; line-height: 1.2;">
              <i class="lni lni-shield me-1"></i> Class 1 Licensed Electrical Contractor
            </span>
          </div>
          <h1 class="display-4 fw-bold text-white mb-3">Contact GlobSol</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-0">
            Have a Class 1 electrical contracting (up to 33kV), turnkey solar PV EPC & AMC, industrial logistics, or technical manpower supply project in mind? Reach out to our engineering team.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Contact Section -->
  <section class="py-5 bg-light">
    <div class="container">
      <div class="row g-4 align-items-start">
        <!-- Left Info Column -->
        <div class="col-lg-5">
          <div class="pe-lg-4">
            <div class="section-title mb-4">
              <span class="text-primary fw-bold text-uppercase tracking-wider small d-block mb-1">Engineering Consultation</span>
              <h2 class="h3 fw-bold text-dark mb-3">Let's Build Something Great</h2>
              <p class="text-secondary">
                Fill out the project inquiry form or reach us directly. Our engineering leads respond to all commercial and government RFPs within 24 business hours.
              </p>
            </div>

            <div class="d-flex flex-column gap-3 mb-4">
              <!-- Email Card -->
              <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="row align-items-center g-3">
                  <div class="col-auto">
                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm bg-gs-gradient" style="width: 52px; height: 52px;">
                      <i class="lni lni-envelope fs-4"></i>
                    </div>
                  </div>
                  <div class="col">
                    <div class="text-secondary small fw-semibold mb-1">Email Us Directly</div>
                    <div>
                      <a href="mailto:info@globsol.co.in" class="fw-bold text-primary text-decoration-none fs-6">info@globsol.co.in</a>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Statutory Licensing Card -->
              <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="row align-items-center g-3">
                  <div class="col-auto">
                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm bg-gs-gradient" style="width: 52px; height: 52px;">
                      <i class="lni lni-shield fs-4"></i>
                    </div>
                  </div>
                  <div class="col">
                    <div class="text-secondary small fw-semibold mb-1">Statutory Licensing</div>
                    <div class="fw-bold text-dark fs-6">Class 1 Electrical License (Up to 33kV)</div>
                  </div>
                </div>
              </div>

              <!-- Operational Reach Card -->
              <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="row align-items-center g-3">
                  <div class="col-auto">
                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm bg-gs-gradient" style="width: 52px; height: 52px;">
                      <i class="lni lni-map-marker fs-4"></i>
                    </div>
                  </div>
                  <div class="col">
                    <div class="text-secondary small fw-semibold mb-1">Operational Reach</div>
                    <div class="fw-bold text-dark fs-6">South India Execution (Electrical, Solar, Logistics & Manpower Supply)</div>
                  </div>
                </div>
              </div>

              <!-- Social Media Channels Card -->
              <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="row align-items-center g-3">
                  <div class="col-auto">
                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm bg-gs-gradient" style="width: 52px; height: 52px;">
                      <i class="lni lni-share fs-4"></i>
                    </div>
                  </div>
                  <div class="col">
                    <div class="text-secondary small fw-semibold mb-1">Follow Our Channels</div>
                    <div class="d-flex align-items-center gap-3 mt-1">
                      <a href="https://www.facebook.com/GSPPL2020/" target="_blank" rel="noopener noreferrer" class="text-primary text-decoration-none fw-semibold d-inline-flex align-items-center gap-1">
                        <i class="lni lni-facebook-filled fs-5"></i> Facebook
                      </a>
                      <span class="text-muted">•</span>
                      <a href="https://www.instagram.com/globsolpower/" target="_blank" rel="noopener noreferrer" class="text-danger text-decoration-none fw-semibold d-inline-flex align-items-center gap-1">
                        <i class="lni lni-instagram-filled fs-5"></i> Instagram
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Form Column -->
        <div class="col-lg-7">
          <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-4 p-md-5">
            <h3 class="h4 fw-bold text-dark mb-2">Request Project Estimate</h3>
            <p class="text-secondary small mb-4">Share your technical scope, site specifications, or inquiry details below.</p>
            
            <!-- Formsubmit.co Free Endpoint Form -->
            <div id="form-error" class="alert alert-danger d-none rounded-3 py-2 small mb-3">
              <i class="lni lni-warning me-1"></i> Something went wrong while submitting. Please try again or email us directly at <a href="mailto:info@globsol.co.in" class="fw-bold">info@globsol.co.in</a>.
            </div>

            <form id="contact-form" action="https://formsubmit.co/info@globsol.co.in" method="POST">
              <!-- FormSubmit Configuration -->
              <input type="hidden" name="_subject" value="New Project Inquiry - GlobSol Power" />
              <input type="hidden" name="_template" value="table" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="text" name="_honey" style="display:none" />

              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label small fw-bold text-dark">Your Full Name *</label>
                  <input type="text" name="name" class="form-control form-control-lg fs-6 rounded-3" placeholder="e.g. Rajesh Kumar" required />
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-bold text-dark">Corporate / Personal Email *</label>
                  <input type="email" name="email" class="form-control form-control-lg fs-6 rounded-3" placeholder="e.g. rajesh@company.com" required />
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-bold text-dark">Phone Number</label>
                  <input type="tel" name="phone" class="form-control form-control-lg fs-6 rounded-3" placeholder="+91 98765 43210" />
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-bold text-dark">Required Service Area</label>
                  <select name="service" class="form-select form-select-lg fs-6 rounded-3">
                    <option value="Electrical Contractor">Class 1 Electrical Contracting (Up to 33kV)</option>
                    <option value="Solar EPC">Solar PV EPC Solutions & AMC</option>
                    <option value="Logistics & Manpower">Industrial Logistics & Technical Manpower Supply</option>
                    <option value="General Inquiry">General Commercial Inquiry</option>
                  </select>
                </div>
                <div class="col-12">
                  <label class="form-label small fw-bold text-dark">Project Details / Message Scope *</label>
                  <textarea name="message" rows="4" class="form-control form-control-lg fs-6 rounded-3" placeholder="Provide project location, voltage rating, MW size, or power & logistics requirements..." required></textarea>
                </div>
                <div class="col-12 mt-4">
                  <button type="submit" id="submit-btn" class="btn btn-lg w-100 py-3 rounded-pill fw-bold text-white shadow-sm bg-gs-gradient border-0 d-flex align-items-center justify-content-center">
                    <span>Submit Inquiry</span> <i class="lni lni-arrow-right ms-2"></i>
                  </button>
                </div>
              </div>
            </form>

            <!-- Success State Box -->
            <div id="form-success" class="d-none text-center py-4">
              <div class="rounded-circle text-white d-inline-flex align-items-center justify-content-center shadow mb-3 bg-success" style="width: 64px; height: 64px;">
                <i class="lni lni-checkmark fs-2"></i>
              </div>
              <h4 class="fw-bold text-dark mb-2">Inquiry Submitted Successfully!</h4>
              <p class="text-secondary small max-w-md mx-auto mb-4">
                Thank you for contacting GlobSol Power. Our engineering team has received your project details and will review and respond within 24 business hours.
              </p>
              <button type="button" id="submit-another-btn" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold btn-sm">
                Submit Another Inquiry
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contact-form');
      const formSuccess = document.getElementById('form-success');
      const formError = document.getElementById('form-error');
      const submitBtn = document.getElementById('submit-btn');
      const submitAnotherBtn = document.getElementById('submit-another-btn');

      if (!form) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        if (formError) formError.classList.add('d-none');
        
        const originalBtnContent = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span>Sending Inquiry...</span> <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true"></span>`;

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
          const response = await fetch('https://formsubmit.co/ajax/info@globsol.co.in', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(data)
          });

          if (response.ok) {
            form.reset();
            form.classList.add('d-none');
            if (formSuccess) formSuccess.classList.remove('d-none');
          } else {
            // If AJAX returns non-ok, fall back to native form submission
            form.submit();
          }
        } catch (err) {
          // If fetch fails or network blocked, fall back to native form submission
          form.submit();
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnContent;
        }
      });

      if (submitAnotherBtn) {
        submitAnotherBtn.addEventListener('click', () => {
          if (formSuccess) formSuccess.classList.add('d-none');
          if (form) form.classList.remove('d-none');
        });
      }
    });
  </script>
</BaseLayout>
