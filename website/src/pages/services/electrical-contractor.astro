---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';

const baseUrl = import.meta.env.BASE_URL;

const capabilities = [
  {
    title: "1. HT / LT Line Laying & Substations (Up to 33kV)",
    icon: "lni-bolt",
    description: "Complete high-tension & low-tension line laying, underground cable trenching, transformer erection, and substation commissioning up to 33kV."
  },
  {
    title: "2. Transformer & DG Set Synchronization",
    icon: "lni-cog",
    description: "Designing and operating distribution substations, high-capacity diesel generator (DG) set synchronization, and main switchgear panels."
  },
  {
    title: "3. Electrical Maintenance & Safety Audits",
    icon: "lni-shield",
    description: "Meticulous preventive maintenance, thermographic safety audits, earthing pit testing, and uninterrupted commercial power support."
  },
  {
    title: "4. Statutory Compliance & CEIG Clearances",
    icon: "lni-checkmark-circle",
    description: "Securing Chief Electrical Inspectorate to Government (CEIG) approvals, safety certificates, and statutory power grid clearances."
  }
];
---

<BaseLayout 
  title="Class 1 Electrical Contractor Services (up to 33kV) | GlobSol Power Pvt Ltd"
  description="Government Class-1 licensed electrical contractors specializing in HT/LT installations up to 33kV, substations, transformers, and maintenance."
>
  <!-- Page Banner Section -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8 mx-auto">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">Class 1 License (Up to 33kV)</span>
          <h1 class="display-4 fw-bold text-white mb-3">High Voltage Electrical Contracting</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-0">
            Illuminate the Future with Our Licensed High Voltage Electrical Engineering Services.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Capabilities Section -->
  <section class="py-5 bg-light">
    <div class="container">
      <div class="row">
        <div class="col-xl-9 col-lg-10 mx-auto text-center">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInUp" data-wow-delay=".2s">Government Licensed</span>
            <h2 class="mb-3 wow fadeInUp" data-wow-delay=".4s">33kV High Voltage Electrical Capabilities</h2>
            <p class="wow fadeInUp text-secondary" data-wow-delay=".5s">We are Government-licensed Class 1 Electrical Contractors equipped with extensive technical expertise and modern tools. We power residential, commercial, industrial, and defense infrastructure with safety, reliability, and precision.</p>
          </div>
        </div>
      </div>

      <div class="row g-4">
        {capabilities.map((cap, index) => (
          <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 wow fadeInUp" data-wow-delay={`${0.2 * (index + 1)}s`}>
              <div class="row align-items-center g-3">
                <div class="col-auto">
                  <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm bg-gs-gradient" style="width: 52px; height: 52px;">
                    <i class={`lni ${cap.icon} fs-4`}></i>
                  </div>
                </div>
                <div class="col">
                  <h4 class="h5 fw-bold text-dark mb-1">{cap.title}</h4>
                  <p class="text-secondary mb-0 small">{cap.description}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Impact Highlights Section -->
  <section class="py-5 bg-white">
    <div class="container">
      <div class="row">
        <div class="col-xl-6 col-lg-7 col-md-9 mx-auto">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInDown" data-wow-delay=".2s">Track Record</span>
            <h2 class="wow fadeInUp" data-wow-delay=".4s">High Voltage Engineering Excellence</h2>
            <p class="wow fadeInUp text-secondary" data-wow-delay=".6s">Proven contracting reliability for defense facilities, public sector undertakings, and commercial complexes.</p>
          </div>
        </div>
      </div>

      <div class="row g-4 justify-content-center">
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">33kV</h3>
            <h4 class="h5 text-white fw-bold mb-2">High Voltage Rating</h4>
            <p class="small text-white-50 mb-0">HT/LT Substations, Transformers & Power Distribution</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">100%</h3>
            <h4 class="h5 text-white fw-bold mb-2">CEIG Clearances</h4>
            <p class="small text-white-50 mb-0">Government Approved Electrical Safety Certificates</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">PSU & Defense</h3>
            <h4 class="h5 text-white fw-bold mb-2">Trusted Contracting</h4>
            <p class="small text-white-50 mb-0">Contracted by Bharat Electronics, HAL, and HMT</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
