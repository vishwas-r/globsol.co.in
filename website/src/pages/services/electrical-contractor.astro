---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout 
  title="Class 1 Electrical Contractor Services (up to 33kV) | GlobSol Power Pvt Ltd"
  description="Government Class-1 licensed electrical contractors specializing in HT/LT installations up to 33kV, substations, transformers, and maintenance."
>
  <!-- Page Banner Section -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container py-4">
      <div class="row">
        <div class="col-lg-12">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">Electrical Contracting</span>
          <h1 class="display-4 fw-bold text-white mb-3">Class 1 Electrical Contractor (up to 33kV)</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-0">
            Illuminate the Future with Our Licensed High Voltage Electrical Engineering Services.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-white">
    <div class="container py-4">
      <div class="row justify-content-center">
        <div class="col-lg-10">
          <p class="fs-5 text-secondary mb-5">
            We are Government-licensed Class 1 Electrical Contractors equipped with extensive technical expertise and modern tools. We power residential, commercial, industrial, and defense infrastructure with safety, reliability, and precision.
          </p>

          <div class="row g-4 mb-5">
            <div class="col-md-6">
              <div class="p-4 rounded-3 border bg-light h-100">
                <h4 class="h5 fw-bold text-primary mb-2">HT / LT Installations up to 33kV</h4>
                <p class="text-secondary mb-0">Complete high-tension & low-tension line laying, cable trenching, transformer erection, and substation commissioning up to 33kV.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-4 rounded-3 border bg-light h-100">
                <h4 class="h5 fw-bold text-primary mb-2">Substation & DG Set Operations</h4>
                <p class="text-secondary mb-0">Designing and operating distribution substations, high-capacity diesel generator (DG) set synchronization, and switchgear panels.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-4 rounded-3 border bg-light h-100">
                <h4 class="h5 fw-bold text-primary mb-2">Electrical Maintenance & Audits</h4>
                <p class="text-secondary mb-0">Meticulous preventive maintenance, thermographic safety audits, earthing pit testing, and uninterrupted power support.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-4 rounded-3 border bg-light h-100">
                <h4 class="h5 fw-bold text-primary mb-2">Government Compliance & CEIG Approval</h4>
                <p class="text-secondary mb-0">Securing Chief Electrical Inspectorate to Government (CEIG) approvals, safety certificates, and statutory power clearances.</p>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-3 text-center text-white mb-5 bg-gs-gradient">
            <h4 class="text-white fw-bold mb-2">Need High Voltage Electrical Execution?</h4>
            <p class="fs-6 mb-3 text-white-50">Get Class-1 licensed electrical contracting backed by 33kV substation expertise.</p>
            <a href={`${baseUrl}contact`} class="btn btn-light fw-bold text-primary px-4 py-2 rounded-pill shadow-sm">Contact Electrical Engineers</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
