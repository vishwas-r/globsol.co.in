---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';

const baseUrl = import.meta.env.BASE_URL;

const capabilities = [
  {
    title: "1. Solar Engineering & Design",
    icon: "lni-sun",
    description: "Custom PV array layout design, shadow analysis, string sizing, structural weight capacity audit, and yield estimation."
  },
  {
    title: "2. Tier-1 Component Procurement",
    icon: "lni-cog",
    description: "Sourcing Tier-1 mono-PERC solar panels, high-efficiency central/string inverters, aluminum mounting structures, and DC cabling."
  },
  {
    title: "3. Turnkey Installation & Grid Sync",
    icon: "lni-bolt",
    description: "Rooftop and ground-mount structural installation, electrical wiring, bi-directional net metering approvals, and grid sync."
  },
  {
    title: "4. Operations & Maintenance (O&M)",
    icon: "lni-stats-up",
    description: "Long-term plant monitoring, automated panel cleaning schedule, inverter servicing, and yield optimization support."
  }
];
---

<BaseLayout 
  title="Turnkey Solar PV EPC Solutions | GlobSol Power Pvt Ltd"
  description="Turnkey solar engineering, procurement, and construction (EPC) for rooftop & ground-mounted solar power plants (on-grid & off-grid)."
>
  <!-- Page Banner Section -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8 mx-auto">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">Solar EPC Solutions</span>
          <h1 class="display-4 fw-bold text-white mb-3">Turnkey Solar PV EPC Solutions</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-0">
            End-to-End Rooftop & Ground-Mounted Solar Power Plants across India.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Capabilities Section -->
  <section class="py-5 bg-light">
    <div class="container">
      <div class="row">
        <div class="col-xl-9 col-lg-10 mx-auto text-center">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInUp" data-wow-delay=".2s">Turnkey Execution</span>
            <h2 class="mb-3 wow fadeInUp" data-wow-delay=".4s">Our Solar Engineering Scope</h2>
            <p class="wow fadeInUp text-secondary" data-wow-delay=".5s">From initial solar radiation assessment to net-metering synchronization, GlobSol delivers comprehensive Solar PV EPC solutions for commercial, industrial, and institutional clients.</p>
          </div>
        </div>
      </div>

      <div class="row g-4">
        {capabilities.map((cap, index) => (
          <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 wow fadeInUp" data-wow-delay={`${0.2 * (index + 1)}s`}>
              <div class="row align-items-center g-3">
                <div class="col-auto">
                  <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm bg-gs-gradient" style="width: 52px; height: 52px;">
                    <i class={`lni ${cap.icon} fs-4`}></i>
                  </div>
                </div>
                <div class="col">
                  <h4 class="h5 fw-bold text-dark mb-1">{cap.title}</h4>
                  <p class="text-secondary mb-0 small">{cap.description}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Impact Highlights Section -->
  <section class="py-5 bg-white">
    <div class="container">
      <div class="row">
        <div class="col-xl-6 col-lg-7 col-md-9 mx-auto">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInDown" data-wow-delay=".2s">Key Advantages</span>
            <h2 class="wow fadeInUp" data-wow-delay=".4s">Why Choose GlobSol Solar EPC?</h2>
            <p class="wow fadeInUp text-secondary" data-wow-delay=".6s">Maximizing clean energy yield with turnkey statutory and engineering precision.</p>
          </div>
        </div>
      </div>

      <div class="row g-4 justify-content-center">
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">Megawatt</h3>
            <h4 class="h5 text-white fw-bold mb-2">Scale Capabilities</h4>
            <p class="small text-white-50 mb-0">Roof-mounted & Ground-mounted Solar PV Installations</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">On / Off</h3>
            <h4 class="h5 text-white fw-bold mb-2">Grid Synchronization</h4>
            <p class="small text-white-50 mb-0">Bi-Directional Net-Metering & Hybrid Battery Storage Systems</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">25 Years</h3>
            <h4 class="h5 text-white fw-bold mb-2">Panel Performance Warranty</h4>
            <p class="small text-white-50 mb-0">Tier-1 Components & Long-term Yield Optimization</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
