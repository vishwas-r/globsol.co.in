---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';
---

<BaseLayout 
  title="Turnkey Solar PV EPC Solutions | GlobSol Power Pvt Ltd"
  description="Turnkey solar engineering, procurement, and construction (EPC) for rooftop & ground-mounted solar power plants (on-grid & off-grid)."
>
  <section class="page-banner-section pt-130 pb-80" style="background: linear-gradient(135deg, #1e73be 0%, #0d4b82 100%);">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 text-center text-white">
          <span class="text-white-50 text-uppercase fw-bold tracking-wider">Services</span>
          <h1 class="display-4 fw-bold text-white mt-2 mb-3">Turnkey Solar PV EPC Solutions</h1>
          <p class="lead max-w-xl mx-auto opacity-90" style="max-width: 700px; margin: 0 auto;">
            Harvest the Sun's Potential with Sustainable On-Grid and Off-Grid Solar Energy
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-white">
    <div class="container py-4">
      <div class="row justify-content-center">
        <div class="col-lg-10">
          <p class="fs-5 text-secondary mb-5">
            From initial solar radiation assessment to net-metering synchronization, GlobSol delivers comprehensive Solar PV EPC (Engineering, Procurement, and Construction) solutions for commercial, industrial, and institutional clients.
          </p>

          <div class="row g-4 mb-5">
            <div class="col-md-6">
              <div class="p-4 rounded-3 border bg-light h-100">
                <h4 class="h5 fw-bold text-primary mb-2">1. Solar Engineering & Design</h4>
                <p class="text-secondary mb-0">Custom PV array layout design, shadow analysis, string sizing, structural weight capacity audit, and yield estimation.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-4 rounded-3 border bg-light h-100">
                <h4 class="h5 fw-bold text-primary mb-2">2. Procurement & Quality Tier-1 Components</h4>
                <p class="text-secondary mb-0">Sourcing Tier-1 mono-PERC solar panels, high-efficiency central/string inverters, aluminum mounting structures, and DC cabling.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-4 rounded-3 border bg-light h-100">
                <h4 class="h5 fw-bold text-primary mb-2">3. Turnkey Installation & Grid Synchronization</h4>
                <p class="text-secondary mb-0">Rooftop and ground-mount structural installation, electrical wiring, bi-directional net metering approvals, and grid sync.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-4 rounded-3 border bg-light h-100">
                <h4 class="h5 fw-bold text-primary mb-2">4. Operations & Maintenance (O&M)</h4>
                <p class="text-secondary mb-0">Long-term plant monitoring, automated panel cleaning schedule, inverter servicing, and yield optimization support.</p>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-3 text-center text-white mb-5" style="background: linear-gradient(135deg, #3763eb 0%, #6f58e8 100%);">
            <h4 class="text-white fw-bold mb-2">Ready to Transition to Clean Solar Energy?</h4>
            <p class="fs-6 mb-3 opacity-90">Reduce power bills and footprint with GlobSol's turnkey Solar PV EPC.</p>
            <a href="/contact" class="btn btn-light fw-bold text-primary px-4 py-2 rounded-pill">Request Solar Site Audit</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
