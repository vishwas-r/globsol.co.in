---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';
---

<BaseLayout 
  title="Construction & Interior Design | GlobSol Power Pvt Ltd"
  description="Comprehensive construction management, feasibility studies, interior design fit-outs, and architectural execution."
>
  <!-- Page Banner Section -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container py-4">
      <div class="row">
        <div class="col-lg-12">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">Construction & Interiors</span>
          <h1 class="display-4 fw-bold text-white mb-3">Civil Construction & Luxury Interior Design</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-0">
            End-to-End Architectural Execution, Structural Construction, and Premium Fit-outs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-white">
    <div class="container py-4">
      <div class="row justify-content-center">
        <div class="col-lg-10">
          <p class="fs-5 text-secondary mb-5">
            GlobSol brings comprehensive civil engineering capability alongside luxury interior design. From structural groundwork to high-end interior turnkeys for hospitality and commercial spaces, we deliver project perfection on time.
          </p>

          <div class="row g-4 mb-5">
            <div class="col-md-6">
              <div class="p-4 rounded-3 border bg-light h-100">
                <h4 class="h5 fw-bold text-primary mb-2">1. Civil Construction & Structural Execution</h4>
                <p class="text-secondary mb-0">Turnkey civil works for industrial facilities, commercial complexes, and residential developments built to code.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-4 rounded-3 border bg-light h-100">
                <h4 class="h5 fw-bold text-primary mb-2">2. Hospitality & Luxury Interior Fit-outs</h4>
                <p class="text-secondary mb-0">Specialized interior fit-outs for luxury resorts, boutique hotels (Rosetta Hospitality), corporate headquarters, and retail spaces.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-4 rounded-3 border bg-light h-100">
                <h4 class="h5 fw-bold text-primary mb-2">3. Architectural & Spatial Planning</h4>
                <p class="text-secondary mb-0">Custom floorplan design, 3D visualization, structural integrity analysis, and material selection consultation.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-4 rounded-3 border bg-light h-100">
                <h4 class="h5 fw-bold text-primary mb-2">4. Integrated MEP & Building Services</h4>
                <p class="text-secondary mb-0">Seamless integration of mechanical, electrical, and plumbing (MEP) systems directly within architectural structural designs.</p>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-3 text-center text-white mb-5 bg-gs-gradient">
            <h4 class="text-white fw-bold mb-2">Planning a Civil Construction or Interior Project?</h4>
            <p class="fs-6 mb-3 text-white-50">Consult with our structural engineers and architectural interior design team.</p>
            <a href="/contact" class="btn btn-light fw-bold text-primary px-4 py-2 rounded-pill shadow-sm">Get Project Estimate</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
