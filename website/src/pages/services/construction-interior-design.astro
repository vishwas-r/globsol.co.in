---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';

const baseUrl = import.meta.env.BASE_URL;

const capabilities = [
  {
    title: "1. Civil Construction & Structural Execution",
    icon: "lni-layout",
    description: "Turnkey civil works for industrial facilities, commercial complexes, and residential developments built strictly to code."
  },
  {
    title: "2. Hospitality & Luxury Interior Fit-outs",
    icon: "lni-brush",
    description: "Specialized interior fit-outs for luxury resorts, boutique hotels (Rosetta Hospitality), corporate headquarters, and retail spaces."
  },
  {
    title: "3. Architectural & Spatial Planning",
    icon: "lni-ruler-pencil",
    description: "Custom floorplan design, 3D visualization, structural integrity analysis, and premium material selection consultation."
  },
  {
    title: "4. Integrated MEP & Building Services",
    icon: "lni-cog",
    description: "Seamless integration of mechanical, electrical, and plumbing (MEP) systems directly within architectural structural designs."
  }
];
---

<BaseLayout 
  title="Construction & Interior Design | GlobSol Power Pvt Ltd"
  description="Comprehensive construction management, feasibility studies, interior design fit-outs, and architectural execution."
>
  <!-- Page Banner Section -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8 mx-auto">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">Construction & Interiors</span>
          <h1 class="display-4 fw-bold text-white mb-3">Civil Construction & Luxury Interior Design</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-0">
            End-to-End Architectural Execution, Structural Construction, and Premium Fit-outs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Capabilities Section -->
  <section class="py-5 bg-light">
    <div class="container">
      <div class="row">
        <div class="col-xl-9 col-lg-10 mx-auto text-center">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInUp" data-wow-delay=".2s">Structural & Aesthetics</span>
            <h2 class="mb-3 wow fadeInUp" data-wow-delay=".4s">Our Construction & Interior Services</h2>
            <p class="wow fadeInUp text-secondary" data-wow-delay=".5s">GlobSol brings comprehensive civil engineering capability alongside luxury interior design. From structural groundwork to high-end interior turnkeys for hospitality and commercial spaces, we deliver project perfection on time.</p>
          </div>
        </div>
      </div>

      <div class="row g-4">
        {capabilities.map((cap, index) => (
          <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 wow fadeInUp" data-wow-delay={`${0.2 * (index + 1)}s`}>
              <div class="row align-items-center g-3">
                <div class="col-auto">
                  <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 52px; height: 52px; background: linear-gradient(135deg, #3763eb 0%, #6f58e8 100%);">
                    <i class={`lni ${cap.icon} fs-4`}></i>
                  </div>
                </div>
                <div class="col">
                  <h4 class="h5 fw-bold text-dark mb-1">{cap.title}</h4>
                  <p class="text-secondary mb-0 small">{cap.description}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Impact Highlights Section -->
  <section class="py-5 bg-white">
    <div class="container">
      <div class="row">
        <div class="col-xl-6 col-lg-7 col-md-9 mx-auto">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInDown" data-wow-delay=".2s">Key Standards</span>
            <h2 class="wow fadeInUp" data-wow-delay=".4s">Civil & Architectural Distinction</h2>
            <p class="wow fadeInUp text-secondary" data-wow-delay=".6s">Combining heavy structural integrity with modern aesthetic craftsmanship.</p>
          </div>
        </div>
      </div>

      <div class="row g-4 justify-content-center">
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">Turnkey</h3>
            <h4 class="h5 text-white fw-bold mb-2">Civil Execution</h4>
            <p class="small text-white-50 mb-0">Industrial, Commercial & Residential Structural Construction</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">Luxury</h3>
            <h4 class="h5 text-white fw-bold mb-2">Hospitality Fit-outs</h4>
            <p class="small text-white-50 mb-0">Contractor for Rosetta Hospitality & Premier Commercial Spaces</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">Integrated</h3>
            <h4 class="h5 text-white fw-bold mb-2">MEP Engineering</h4>
            <p class="small text-white-50 mb-0">Harmonized Electrical, Mechanical & Plumbing Integration</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
