---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';

const baseUrl = import.meta.env.BASE_URL;

const capabilities = [
  {
    title: "1. Industrial Logistics & Supply Chain Management",
    icon: "lni-delivery",
    description: "End-to-end transportation, material handling, site logistics, and supply chain management for industrial and power infrastructure projects."
  },
  {
    title: "2. Skilled Technical Manpower Supply",
    icon: "lni-users",
    description: "Deployment of certified electrical technicians, HT line specialists, substation operators, and solar PV commissioning engineers across India."
  },
  {
    title: "3. Heavy Equipment & Plant Logistics",
    icon: "lni-caravan",
    description: "Specialized logistics and heavy haulage for electrical transformers, solar PV equipment, switchgear panels, and industrial machinery."
  },
  {
    title: "4. Workforce Management & Compliance",
    icon: "lni-shield",
    description: "Complete statutory compliance, labor safety management, site supervision, and skilled workforce deployment for enterprise clients."
  }
];
---

<BaseLayout 
  title="Logistics & Manpower Supply | GlobSol Power Pvt Ltd"
  description="Comprehensive industrial logistics, heavy equipment handling, and skilled technical manpower supply solutions across India."
>
  <!-- Page Banner Section -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8 mx-auto">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">Logistics & Manpower</span>
          <h1 class="display-4 fw-bold text-white mb-3">Industrial Logistics & Technical Manpower Supply</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-0">
            Reliable Supply Chain Operations and Certified Technical Workforce Solutions Across India.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Capabilities Section -->
  <section class="py-5 bg-light">
    <div class="container">
      <div class="row">
        <div class="col-xl-9 col-lg-10 mx-auto text-center">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInUp" data-wow-delay=".2s">Supply Chain & Workforce</span>
            <h2 class="mb-3 wow fadeInUp" data-wow-delay=".4s">Our Logistics & Manpower Capabilities</h2>
            <p class="wow fadeInUp text-secondary" data-wow-delay=".5s">GlobSol provides specialized industrial logistics management along with certified technical manpower supply. We ensure seamless equipment transportation and deploy qualified engineering workforces to power complex enterprise projects.</p>
          </div>
        </div>
      </div>

      <div class="row g-4">
        {capabilities.map((cap, index) => (
          <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 wow fadeInUp" data-wow-delay={`${0.2 * (index + 1)}s`}>
              <div class="row align-items-center g-3">
                <div class="col-auto">
                  <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 52px; height: 52px; background: linear-gradient(135deg, #3763eb 0%, #6f58e8 100%);">
                    <i class={`lni ${cap.icon} fs-4`}></i>
                  </div>
                </div>
                <div class="col">
                  <h4 class="h5 fw-bold text-dark mb-1">{cap.title}</h4>
                  <p class="text-secondary mb-0 small">{cap.description}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Impact Highlights Section -->
  <section class="py-5 bg-white">
    <div class="container">
      <div class="row">
        <div class="col-xl-6 col-lg-7 col-md-9 mx-auto">
          <div class="section-title text-center mb-5">
            <span class="wow fadeInDown" data-wow-delay=".2s">Key Standards</span>
            <h2 class="wow fadeInUp" data-wow-delay=".4s">Operational Excellence</h2>
            <p class="wow fadeInUp text-secondary" data-wow-delay=".6s">Combining heavy equipment logistics with certified technical manpower deployment.</p>
          </div>
        </div>
      </div>

      <div class="row g-4 justify-content-center">
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">Pan-India</h3>
            <h4 class="h5 text-white fw-bold mb-2">Logistics Reach</h4>
            <p class="small text-white-50 mb-0">Heavy Haulage, Material Handling & Site Logistics</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">Certified</h3>
            <h4 class="h5 text-white fw-bold mb-2">Technical Workforce</h4>
            <p class="small text-white-50 mb-0">Skilled Electrical Technicians, Engineers & Operators</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="p-4 p-lg-5 text-center text-white rounded-4 shadow-sm h-100 bg-gs-gradient">
            <h3 class="display-4 fw-bold text-white mb-2">100%</h3>
            <h4 class="h5 text-white fw-bold mb-2">Labor Compliance</h4>
            <p class="small text-white-50 mb-0">Full Safety Certification & Statutory Compliance</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
