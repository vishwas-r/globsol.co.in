---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicesOverview from '../../components/ServicesOverview.astro';
import ContactSection from '../../components/ContactSection.astro';
---

<BaseLayout 
  title="Our Services | GlobSol Power Pvt Ltd"
  description="Explore GlobSol Power's specialized capabilities in High-Voltage Electrical Contracting up to 33kV, Turnkey Solar PV EPC & AMC, and Industrial Logistics & Technical Manpower Supply."
>
  <!-- Page Banner Section (Matching About Us Design) -->
  <section class="page-banner-section py-5 bg-gs-gradient text-white text-center">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8 mx-auto">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">What We Do</span>
          <h1 class="display-4 fw-bold text-white mb-3">Engineering, Logistics & Contracting Solutions</h1>
          <p class="lead text-white-50 max-w-xl mx-auto mb-0">
            Explore our specialized capabilities in High-Voltage Electrical Contracting (Up to 33kV), Turnkey Solar PV EPC & AMC Solutions, and Industrial Logistics & Technical Manpower Supply.
          </p>
        </div>
      </div>
    </div>
  </section>

  <ServicesOverview />
  <ContactSection />
</BaseLayout>
