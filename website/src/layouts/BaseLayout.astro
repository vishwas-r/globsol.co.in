---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "GlobSol Power Pvt Ltd | Electrical, Solar, Logistics & Manpower Supply",
  description = "Elevate projects with GlobSol's Class 1 electrical contracting up to 33kV, turnkey solar PV EPC & AMC solutions, and industrial logistics & technical manpower supply across South India.",
  image = "/assets/img/logo/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://globsol.co.in");
const siteOrigin = Astro.site ? Astro.site.href.replace(/\/$/, '') : "https://globsol.co.in";
const imageURL = new URL(image, siteOrigin).href;
const faviconIcoURL = `${siteOrigin}/favicon.ico`;
const favicon32URL = `${siteOrigin}/favicon-32x32.png`;
const favicon192URL = `${siteOrigin}/favicon.png`;
const appleTouchIconURL = `${siteOrigin}/apple-touch-icon.png`;
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="GlobSol Power Pvt Ltd" />

  <!-- Favicon (Brand Globe Icon - Full Absolute URLs) -->
  <link rel="icon" type="image/x-icon" href={faviconIcoURL} />
  <link rel="icon" type="image/png" sizes="32x32" href={favicon32URL} />
  <link rel="icon" type="image/png" sizes="192x192" href={favicon192URL} />
  <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconURL} />
  <link rel="shortcut icon" href={faviconIcoURL} />
  
  <!-- Space Theme CSS -->
  <link rel="stylesheet" href="/assets/css/bootstrap-5.0.0-alpha.min.css" />
  <link rel="stylesheet" href="/assets/css/LineIcons.2.0.css" />
  <link rel="stylesheet" href="/assets/css/animate.css" />
  <link rel="stylesheet" href="/assets/css/tiny-slider.css" />
  <link rel="stylesheet" href="/assets/css/glightbox.min.css" />
  <link rel="stylesheet" href="/assets/css/main.css" />
  <link rel="stylesheet" href="/assets/css/style.css" />

  <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="GlobSol Power Pvt Ltd" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:image:secure_url" content={imageURL} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="GlobSol Power Pvt Ltd - Engineering Excellence" />
  <meta property="og:locale" content="en_IN" />
  
  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL.href} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />
  <meta name="twitter:image:alt" content="GlobSol Power Pvt Ltd" />

  <!-- Structured Data (JSON-LD) for Search Engines -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "GlobSol Power Pvt Ltd",
    "url": "https://globsol.co.in",
    "logo": `${siteOrigin}/assets/img/logo/logo.png`,
    "image": imageURL,
    "description": description,
    "email": "info@globsol.co.in",
    "areaServed": "South India",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "IN",
      "addressRegion": "Karnataka"
    },
    "sameAs": [
      "https://www.facebook.com/GSPPL2020/",
      "https://www.instagram.com/globsolpower/"
    ]
  })} />

  <!-- Google Tag / GA4 (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-EJ0Q6WVL43"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-EJ0Q6WVL43');
  </script>
</head>
<body class={isHome ? "home-page" : "inner-page"}>
  <!-- Preloader -->
  <div class="preloader">
    <div class="loader">
      <div class="ytp-spinner">
        <div class="ytp-spinner-container">
          <div class="ytp-spinner-rotator">
            <div class="ytp-spinner-left">
              <div class="ytp-spinner-circle"></div>
            </div>
            <div class="ytp-spinner-right">
              <div class="ytp-spinner-circle"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Navbar />
  
  <main>
    <slot />
  </main>
  
  <Footer />
  
  <ScrollToTop />

  <!-- Vendor JS Files -->
  <script is:inline src={`${import.meta.env.BASE_URL}assets/js/bootstrap.bundle-5.0.0.alpha-min.js`}></script>
  <script is:inline src={`${import.meta.env.BASE_URL}assets/js/contact-form.js`}></script>
  <script is:inline src={`${import.meta.env.BASE_URL}assets/js/count-up.min.js`}></script>
  <script is:inline src={`${import.meta.env.BASE_URL}assets/js/tiny-slider.js`}></script>
  <script is:inline src={`${import.meta.env.BASE_URL}assets/js/isotope.min.js`}></script>
  <script is:inline src={`${import.meta.env.BASE_URL}assets/js/glightbox.min.js`}></script>
  <script is:inline src={`${import.meta.env.BASE_URL}assets/js/wow.min.js`}></script>
  <script is:inline src={`${import.meta.env.BASE_URL}assets/js/imagesloaded.min.js`}></script>
  <script is:inline src={`${import.meta.env.BASE_URL}assets/js/main.js`}></script>

  <script is:inline>
    // ========= GLightbox (Scoped per project gallery so it stops at current project)
    if (typeof GLightbox !== 'undefined' && document.querySelectorAll('.glightbox').length > 0) {
      const galleryNodes = document.querySelectorAll('[data-gallery]');
      const galleries = new Set();
      galleryNodes.forEach(node => {
        const galleryName = node.getAttribute('data-gallery');
        if (galleryName) galleries.add(galleryName);
      });

      if (galleries.size > 0) {
        galleries.forEach(galleryName => {
          GLightbox({
            selector: `[data-gallery="${galleryName}"]`,
            loop: false
          });
        });
      } else {
        GLightbox({
          selector: '.glightbox',
          loop: false
        });
      }
    }

    // ========= Testimonial Slider
    if (typeof tns !== 'undefined' && document.querySelector('.testimonial-active')) {
      tns({
        container: '.testimonial-active',
        items: 1,
        slideBy: 'page',
        autoplay: false,
        mouseDrag: true,
        gutter: 0,
        nav: false,
        controlsText: ['<i class="lni lni-arrow-left"></i>', '<i class="lni lni-arrow-right"></i>'],
      });
    }

    // ========= Isotope Masonry
    if (typeof imagesLoaded !== 'undefined' && document.querySelector('#container')) {
      imagesLoaded('#container', function() {
        var elem = document.querySelector('.grid');
        if (elem && typeof Isotope !== 'undefined') {
          var iso = new Isotope(elem, {
            itemSelector: '.grid-item',
            masonry: {
              columnWidth: '.grid-item'
            }
          });

          let filterButtons = document.querySelectorAll('.portfolio-btn-wrapper button');
          filterButtons.forEach(e => {
            e.addEventListener('click', (event) => {
              filterButtons.forEach(b => b.classList.remove('active'));
              event.target.classList.add('active');
              let filterValue = event.target.getAttribute('data-filter');
              iso.arrange({
                filter: filterValue
              });
            });
          });
        }
      });
    }
  </script>
</body>
</html>

