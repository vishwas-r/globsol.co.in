---
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="footer pt-100">
  <div class="container">
    <div class="row">
      <div class="col-xl-4 col-lg-4 col-md-6">
        <div class="footer-widget mb-60 wow fadeInLeft" data-wow-delay=".2s">
          <a href={baseUrl} class="logo mb-30"><img src={`${baseUrl}assets/img/logo/logo.png`} alt="GlobSol Power Pvt Ltd" style="max-height: 45px; width: auto;"></a>
          <p class="mb-30 footer-desc">Class 1 Government Licensed Electrical Contractors up to 33kV, Turnkey Solar PV EPC & AMC Solutions, and Industrial Logistics & Technical Manpower Supply across India.</p>
          <div class="footer-social-links mt-4 d-flex align-items-center">
            <a href="https://www.facebook.com/GSPPL2020/" target="_blank" rel="noopener noreferrer" class="social-icon rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm me-3" style="width: 38px; height: 38px; background: #1877F2; text-decoration: none; margin-right: 14px;" title="Follow GlobSol on Facebook">
              <i class="lni lni-facebook-filled fs-6"></i>
            </a>
            <a href="https://www.instagram.com/globsolpower/" target="_blank" rel="noopener noreferrer" class="social-icon rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 38px; height: 38px; background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); text-decoration: none;" title="Follow GlobSol on Instagram">
              <i class="lni lni-instagram-filled fs-6"></i>
            </a>
          </div>
        </div>
      </div>
      <div class="col-xl-2 col-lg-2 col-md-6">
        <div class="footer-widget mb-60 wow fadeInUp" data-wow-delay=".4s">
          <h4>Quick Links</h4>
          <ul class="footer-links">
            <li><a href={baseUrl}>Home</a></li>
            <li><a href={`${baseUrl}about-us`}>About Us</a></li>
            <li><a href={`${baseUrl}services`}>Services</a></li>
            <li><a href={`${baseUrl}completed-projects`}>Projects</a></li>
            <li><a href={`${baseUrl}contact`}>Contact Us</a></li>
          </ul>
        </div>
      </div>
      <div class="col-xl-3 col-lg-3 col-md-6">
        <div class="footer-widget mb-60 wow fadeInUp" data-wow-delay=".6s">
          <h4>Our Capabilities</h4>
          <ul class="footer-links">
            <li><a href={`${baseUrl}services/electrical-contractor`}>33kV Substation & Electrical</a></li>
            <li><a href={`${baseUrl}services/solar-epc`}>Solar PV EPC & AMC Solutions</a></li>
            <li><a href={`${baseUrl}services/logistics-manpower-supply`}>Logistics & Manpower Supply</a></li>
            <li><a href={`${baseUrl}about-us/our-happy-clients`}>Client Track Record</a></li>
          </ul>
        </div>
      </div>
      <div class="col-xl-3 col-lg-3 col-md-6">
        <div class="footer-widget mb-60 wow fadeInRight" data-wow-delay=".8s">
          <h4>Contact Us</h4>
          <ul class="footer-contact">
            <li>
              <p><i class="lni lni-envelope me-2"></i> info@globsol.co.in</p>
            </li>
            <li>
              <p><i class="lni lni-shield me-2"></i> Class 1 Govt Electrical Contractor (33kV)</p>
            </li>
            <li>
              <p><i class="lni lni-map-marker me-2"></i> Pan-India Project Execution</p>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="copyright-area">
      <div class="row align-items-center">
        <div class="col-md-6">
          <p class="mb-2 mb-md-0 text-secondary text-center text-md-start">© {new Date().getFullYear()} GlobSol Power Pvt Ltd. All rights reserved.</p>
        </div>
        <div class="col-md-6">
          <p class="wow fadeInUp text-center text-md-end mb-0" data-wow-delay=".3s">
            <a 
              href="https://vishwas.me/?utm_source=globsol.co.in&utm_medium=footer&utm_campaign=developer_credit" 
              target="_blank" 
              rel="noopener" 
              class="developer-credit" 
              style="display: inline-block !important; text-decoration: none !important; text-decoration-line: none !important; border: none !important; outline: none !important;"
            >
              <span 
                class="developer-credit-text" 
                style="display: inline-block !important; text-decoration: none !important; text-decoration-line: none !important; font-size: 14px !important; font-weight: 600 !important; background: linear-gradient(90deg, #3763eb 0%, #6f58e8 50%, #3763eb 100%) !important; background-size: 200% auto !important; -webkit-background-clip: text !important; background-clip: text !important; -webkit-text-fill-color: transparent !important; color: transparent !important; animation: creditGradientFlow 3s linear infinite !important;"
              >
                &lt;/&gt; by VR
              </span>
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  .footer .copyright-area a.developer-credit,
  .footer .copyright-area p a.developer-credit,
  a.developer-credit {
    display: inline-block !important;
    text-decoration: none !important;
    text-decoration-line: none !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
  }
  .footer .copyright-area a.developer-credit:hover,
  .footer .copyright-area p a.developer-credit:hover,
  a.developer-credit:hover {
    text-decoration: none !important;
    border: none !important;
    outline: none !important;
  }
  .footer .copyright-area .developer-credit-text,
  .developer-credit-text {
    display: inline-block !important;
    text-decoration: none !important;
    text-decoration-line: none !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    background: linear-gradient(90deg, #3763eb 0%, #6f58e8 50%, #3763eb 100%) !important;
    background-size: 200% auto !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    color: transparent !important;
    animation: creditGradientFlow 3s linear infinite !important;
    transition: filter 0.3s ease-in-out, transform 0.2s ease-in-out !important;
  }
  .footer .copyright-area a.developer-credit:hover .developer-credit-text,
  .developer-credit-text:hover {
    text-decoration: none !important;
    filter: brightness(1.25) !important;
    transform: translateY(-1px) !important;
  }
  @keyframes creditGradientFlow {
    0% {
      background-position: 0% center;
    }
    100% {
      background-position: 200% center;
    }
  }
</style>
