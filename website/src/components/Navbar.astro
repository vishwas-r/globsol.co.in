---
const baseUrl = import.meta.env.BASE_URL;
---

<header class="header navbar-area">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-12">
        <nav class="navbar navbar-expand-lg">
          <a class="navbar-brand" href={baseUrl}>
            <img src={`${baseUrl}assets/img/logo/logo.png`} alt="GlobSol Power Pvt Ltd" style="max-height: 45px; width: auto;">
          </a>
          <button class="navbar-toggler" type="button" data-toggle="collapse"
            data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
            aria-expanded="false" aria-label="Toggle navigation">
            <span class="toggler-icon"></span>
            <span class="toggler-icon"></span>
            <span class="toggler-icon"></span>
          </button>

          <div class="collapse navbar-collapse sub-menu-bar" id="navbarSupportedContent">
            <ul id="nav" class="navbar-nav ml-auto">
              <li class="nav-item">
                <a class="page-scroll" href={baseUrl}>Home</a>
              </li>
              <li class="nav-item">
                <a class="page-scroll dd-menu" href={`${baseUrl}about-us`}>About Us</a>
                <ul class="sub-menu">
                  <li class="nav-item"><a href={`${baseUrl}about-us/vision`}>Vision</a></li>
                  <li class="nav-item"><a href={`${baseUrl}about-us/mission`}>Mission</a></li>
                  <li class="nav-item"><a href={`${baseUrl}about-us/our-happy-clients`}>Our Happy Clients</a></li>
                </ul>
              </li>
              <li class="nav-item">
                <a class="page-scroll dd-menu" href={`${baseUrl}services`}>Services</a>
                <ul class="sub-menu">
                  <li class="nav-item"><a href={`${baseUrl}services/construction-interior-design`}>Construction & Interior Design</a></li>
                  <li class="nav-item"><a href={`${baseUrl}services/electrical-contractor`}>Electrical Contractor (33kV)</a></li>
                  <li class="nav-item"><a href={`${baseUrl}services/solar-epc`}>Solar EPC</a></li>
                </ul>
              </li>
              <li class="nav-item">
                <a class="page-scroll dd-menu" href={`${baseUrl}completed-projects`}>Projects</a>
                <ul class="sub-menu">
                  <li class="nav-item"><a href={`${baseUrl}completed-projects`}>Completed Projects</a></li>
                  <li class="nav-item"><a href={`${baseUrl}ongoing-projects`}>Ongoing Projects</a></li>
                </ul>
              </li>
              <li class="nav-item">
                <a class="page-scroll" href={`${baseUrl}contact`}>Contact Us</a>
              </li>
            </ul>
          </div> <!-- navbar collapse -->
        </nav> <!-- navbar -->
      </div>
    </div> <!-- row -->
  </div> <!-- container -->
</header>
