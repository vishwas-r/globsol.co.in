---
const baseUrl = import.meta.env.BASE_URL;

const services = [
  {
    title: "Electrical Contractor (Up to 33kV) & Maintenance",
    icon: "lni-bolt",
    link: `${baseUrl}services/electrical-contractor`,
    description: "Turnkey HT & LT installations up to 33kV, substations, transformer commissioning, switchgear, power distribution panels, and rigorous safety maintenance audits."
  },
  {
    title: "Turnkey Solar PV EPC & AMC Solutions",
    icon: "lni-sun",
    link: `${baseUrl}services/solar-epc`,
    description: "End-to-end solar PV plant engineering, procurement, construction, net-metering grid synchronization, and MW-scale annual maintenance contracts (AMC)."
  },
  {
    title: "Industrial Logistics & Technical Manpower Supply",
    icon: "lni-delivery",
    link: `${baseUrl}services/logistics-manpower-supply`,
    description: "Heavy equipment haulage, plant material logistics, supply chain operations, and deployment of certified electrical technicians and specialized engineering workforce."
  }
];
---

<section class="service-section py-5 bg-light">
  <div class="container">
    <div class="row">
      <div class="col-xl-7 col-lg-8 mx-auto text-center">
        <div class="section-title text-center mb-5">
          <span class="wow fadeInDown" data-wow-delay=".2s">Solutions</span>
          <h2 class="wow fadeInUp" data-wow-delay=".4s">Comprehensive Engineering & Operations Solutions</h2>
          <p class="wow fadeInUp text-secondary" data-wow-delay=".6s">End-to-end expertise across 33kV electrical engineering, renewable solar power & AMC, industrial logistics, and technical manpower supply.</p>
        </div>
      </div>
    </div>

    <div class="row g-4">
      {services.map((service, index) => (
        <div class="col-lg-4 col-md-6">
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 wow fadeInUp" data-wow-delay={`${0.2 * (index % 3 + 1)}s`}>
            <div class="d-flex flex-column h-100 justify-content-between">
              <div>
                <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm mb-3 bg-gs-gradient" style="width: 52px; height: 52px;">
                  <i class={`lni ${service.icon} fs-4`}></i>
                </div>
                <h3 class="h5 fw-bold text-dark mb-2">{service.title}</h3>
                <p class="text-secondary small mb-4">{service.description}</p>
              </div>
              <div>
                <a href={service.link} class="fw-bold text-primary text-decoration-none small">
                  Explore Service Details <i class="lni lni-arrow-right ms-1"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
