---
const baseUrl = import.meta.env.BASE_URL;

const services = [
  {
    title: "Industrial Logistics & Haulage",
    icon: "lni-delivery",
    link: `${baseUrl}services/logistics-manpower-supply`,
    description: "End-to-end transportation, site material handling, heavy equipment haulage, and supply chain operations for power & industrial facilities."
  },
  {
    title: "Technical Manpower Supply",
    icon: "lni-users",
    link: `${baseUrl}services/logistics-manpower-supply`,
    description: "Deployment of certified electrical technicians, substation operators, HT line engineers, and solar PV commissioning specialists across India."
  },
  {
    title: "HT / LT Contracting (33kV)",
    icon: "lni-bolt",
    link: `${baseUrl}services/electrical-contractor`,
    description: "Turnkey high voltage installations up to 33kV, substations, transformer commissioning, and power distribution systems."
  },
  {
    title: "Electrical Maintenance & Audits",
    icon: "lni-shield",
    link: `${baseUrl}services/electrical-contractor`,
    description: "Meticulous preventive maintenance, thermographic safety audits, earthing testing, and uninterrupted power support."
  },
  {
    title: "Turnkey Solar PV EPC",
    icon: "lni-sun",
    link: `${baseUrl}services/solar-epc`,
    description: "Complete solar PV plant engineering, procurement, grid synchronization, and commissioning for commercial & industrial clients."
  },
  {
    title: "Solar Operations & Maintenance",
    icon: "lni-stats-up",
    link: `${baseUrl}services/solar-epc`,
    description: "Sustainable solar operations, panel cleaning, yield monitoring, and inverter servicing to maximize clean energy ROI."
  }
];
---

<section class="service-section py-5 bg-light">
  <div class="container">
    <div class="row">
      <div class="col-xl-7 col-lg-8 mx-auto text-center">
        <div class="section-title text-center mb-5">
          <span class="wow fadeInDown" data-wow-delay=".2s">Solutions</span>
          <h2 class="wow fadeInUp" data-wow-delay=".4s">Comprehensive Engineering & Operations Solutions</h2>
          <p class="wow fadeInUp text-secondary" data-wow-delay=".6s">End-to-end expertise across industrial logistics, technical manpower supply, 33kV electrical engineering, and renewable solar power.</p>
        </div>
      </div>
    </div>

    <div class="row g-4">
      {services.map((service, index) => (
        <div class="col-lg-4 col-md-6">
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 wow fadeInUp" data-wow-delay={`${0.2 * (index % 3 + 1)}s`}>
            <div class="d-flex flex-column h-100 justify-content-between">
              <div>
                <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm mb-3" style="width: 52px; height: 52px; background: linear-gradient(135deg, #3763eb 0%, #6f58e8 100%);">
                  <i class={`lni ${service.icon} fs-4`}></i>
                </div>
                <h3 class="h5 fw-bold text-dark mb-2">{service.title}</h3>
                <p class="text-secondary small mb-4">{service.description}</p>
              </div>
              <div>
                <a href={service.link} class="fw-bold text-primary text-decoration-none small">
                  Explore Service Details <i class="lni lni-arrow-right ms-1"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
