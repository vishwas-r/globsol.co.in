<section class="service-section pt-130 pb-80">
  <div class="container">
    <div class="row">
      <div class="col-xl-6 col-lg-7 col-md-9 mx-auto">
        <div class="section-title text-center mb-55">
          <span class="wow fadeInDown" data-wow-delay=".2s">Solutions</span>
          <h2 class="wow fadeInUp" data-wow-delay=".4s">Comprehensive Project Solutions</h2>
          <p class="wow fadeInUp" data-wow-delay=".6s">End-to-end expertise across civil infrastructure, high-voltage electrical engineering, and renewable solar power.</p>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-lg-4 col-md-6">
        <div class="service-box box-style">
          <div class="service-icon box-icon-style">
            <i class="lni lni-construction"></i>
          </div>
          <div class="box-content-style service-content">
            <h4>Civil Construction</h4>
            <p>From groundbreaking structures to commercial facilities, delivering high-grade civil construction with uncompromised quality.</p>
          </div>
        </div>
      </div>
      <div class="col-lg-4 col-md-6">
        <div class="service-box box-style">
          <div class="service-icon box-icon-style">
            <i class="lni lni-layout"></i>
          </div>
          <div class="box-content-style service-content">
            <h4>Interior Design</h4>
            <p>Captivating, functional spatial design and interior fit-outs tailored for corporate offices, commercial, and industrial facilities.</p>
          </div>
        </div>
      </div>
      <div class="col-lg-4 col-md-6">
        <div class="service-box box-style">
          <div class="service-icon box-icon-style">
            <i class="lni lni-bolt"></i>
          </div>
          <div class="box-content-style service-content">
            <h4>HT / LT Contracting (33kV)</h4>
            <p>Turnkey high voltage installations up to 33kV, substations, transformer commissioning, and power distribution systems.</p>
          </div>
        </div>
      </div>
      <div class="col-lg-4 col-md-6">
        <div class="service-box box-style">
          <div class="service-icon box-icon-style">
            <i class="lni lni-cog"></i>
          </div>
          <div class="box-content-style service-content">
            <h4>Electrical Maintenance</h4>
            <p>Meticulous preventive maintenance, safety audits, and operational support ensuring uninterrupted power performance.</p>
          </div>
        </div>
      </div>
      <div class="col-lg-4 col-md-6">
        <div class="service-box box-style">
          <div class="service-icon box-icon-style">
            <i class="lni lni-sun"></i>
          </div>
          <div class="box-content-style service-content">
            <h4>Turnkey Solar EPC</h4>
            <p>Complete solar PV plant engineering, procurement, grid synchronization, and commissioning for commercial & industrial clients.</p>
          </div>
        </div>
      </div>
      <div class="col-lg-4 col-md-6">
        <div class="service-box box-style">
          <div class="service-icon box-icon-style">
            <i class="lni lni-stats-up"></i>
          </div>
          <div class="box-content-style service-content">
            <h4>Solar O&M Expertise</h4>
            <p>Sustainable solar operations, panel cleaning, yield monitoring, and inverter servicing to maximize clean energy ROI.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
