---
const baseUrl = import.meta.env.BASE_URL;
---

<section id="clients" class="client-logo-section py-4">
  <div class="container">
    <div class="client-logo-wrapper">
      <div class="client-logo-carousel d-flex align-items-center justify-content-between flex-wrap gap-4">
        <div class="client-logo">
          <img src={`${baseUrl}assets/img/client-logo/bharat-electronics.png`} alt="Bharat Electronics Limited">
        </div>
        <div class="client-logo">
          <img src={`${baseUrl}assets/img/client-logo/hal.png`} alt="Hindustan Aeronautics Limited">
        </div>
        <div class="client-logo">
          <img src={`${baseUrl}assets/img/client-logo/hmt.png`} alt="HMT">
        </div>
        <div class="client-logo">
          <img src={`${baseUrl}assets/img/client-logo/hitachi.png`} alt="Hitachi">
        </div>
        <div class="client-logo">
          <img src={`${baseUrl}assets/img/client-logo/janani.png`} alt="Janani">
        </div>
        <div class="client-logo">
          <img src={`${baseUrl}assets/img/client-logo/rosetta-hospitality.png`} alt="Rosetta Hospitality">
        </div>
      </div>
    </div>
  </div>
</section>
