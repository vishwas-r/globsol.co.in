---
const baseUrl = import.meta.env.BASE_URL;
---

<section id="contact" class="subscribe-section py-5 bg-gs-gradient text-white">
  <div class="container py-3">
    <div class="row align-items-center">
      <div class="col-xl-8 col-lg-7">
        <div class="section-title mb-4 mb-lg-0">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">Get In Touch</span>
          <h2 class="text-white display-5 fw-bold mb-3 wow fadeInUp" data-wow-delay=".4s">Have a Project in Mind?</h2>
          <p class="lead text-white-50 mb-0 wow fadeInUp" data-wow-delay=".6s">
            Contact GlobSol Power for civil construction, Class 1 electrical contracting up to 33kV, and turnkey solar PV EPC solutions across India.
          </p>
        </div>
      </div>
      <div class="col-xl-4 col-lg-5 text-lg-end">
        <div class="contact-btn wow fadeInRight" data-wow-delay=".4s">
          <a href={`${baseUrl}contact`} class="btn btn-light btn-lg fw-bold text-primary px-4 py-3 rounded-pill shadow-lg hover-lift" style="background-color: #ffffff !important; color: #3763eb !important;">Contact Now</a>
        </div>
      </div>
    </div>
  </div>
</section>
