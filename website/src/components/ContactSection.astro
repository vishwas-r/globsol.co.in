---
const baseUrl = import.meta.env.BASE_URL;
---

<section id="contact" class="subscribe-section py-5 bg-gs-gradient text-white">
  <div class="container py-3">
    <div class="row align-items-center">
      <div class="col-xl-8 col-lg-7">
        <div class="section-title mb-4 mb-lg-0">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="badge bg-white text-primary px-2.5 py-1 rounded-pill fw-bold text-uppercase shadow-sm" style="font-size: 0.72rem; letter-spacing: 0.5px; line-height: 1.2;">Get In Touch</span>
            <span class="badge text-white px-2.5 py-1 rounded-pill fw-semibold shadow-sm" style="background: rgba(255, 255, 255, 0.16); border: 1px solid rgba(255, 255, 255, 0.35); backdrop-filter: blur(6px); font-size: 0.75rem; line-height: 1.2;">
              <i class="lni lni-shield me-1"></i> Class 1 Licensed Electrical Contractor
            </span>
          </div>
          <h2 class="text-white display-5 fw-bold mb-3 wow fadeInUp" data-wow-delay=".4s">Have a Project in Mind?</h2>
          <p class="lead text-white-50 mb-0 wow fadeInUp" data-wow-delay=".6s">
            Contact GlobSol Power for Class 1 licensed electrical contracting up to 33kV, turnkey solar PV EPC & AMC solutions, and industrial logistics & technical manpower supply across India.
          </p>
        </div>
      </div>
      <div class="col-xl-4 col-lg-5 text-lg-end">
        <div class="contact-btn wow fadeInRight" data-wow-delay=".4s">
          <a href={`${baseUrl}contact`} class="btn btn-light btn-lg fw-bold text-primary px-4 py-3 rounded-pill shadow-lg hover-lift" style="background-color: #ffffff !important; color: #3763eb !important;">Contact Us</a>
        </div>
      </div>
    </div>
  </div>
</section>
