---
const baseUrl = import.meta.env.BASE_URL;
---

<section id="portfolio" class="portfolio-section pt-130 pb-100">
  <div class="container">
    <div class="row align-items-end">
      <div class="col-xl-6 col-lg-6">
        <div class="section-title mb-60">
          <span class="wow fadeInDown" data-wow-delay=".2s">Portfolio</span>
          <h2 class="wow fadeInUp" data-wow-delay=".4s">Our Recent Works</h2>
        </div>
      </div>
      <div class="col-xl-6 col-lg-6">
        <div class="section-title mb-60">
          <p class="wow fadeInUp" data-wow-delay=".4s">A glimpse into our completed high-voltage electrical contracting, substation engineering, and solar PV EPC installations delivered across India.</p>
        </div>
      </div>
    </div>

    <div class="row justify-content-center g-4">
      <!-- Project 1: Ferns Corporate Office, Ulsoor -->
      <div class="col-lg-6 col-md-6 wow fadeInUp" data-wow-delay=".2s">
        <div class="portfolio-item-wrapper">
          <div class="portfolio-img">
            <img
              src={`${baseUrl}assets/img/projects/project-placeholder.svg`}
              alt="Ferns Estates & Developers Corporate Office, Ulsoor"
              loading="lazy"
            >
          </div>
          <div class="portfolio-overlay">
            <div class="overlay-content">
              <h4>Ferns Corporate Office, Ulsoor</h4>
              <p>Turnkey electrical contracting, interior power distribution, and power panel engineering delivered for Ferns Estates & Developers.</p>
              <a href={`${baseUrl}completed-projects`} class="theme-btn border-btn">View Project</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Project 2: Reception Block, Rosetta Resorts (Ferns Forest View) -->
      <div class="col-lg-6 col-md-6 wow fadeInUp" data-wow-delay=".4s">
        <div class="portfolio-item-wrapper">
          <div class="portfolio-img">
            <img
              src={`${baseUrl}assets/img/projects/project-placeholder.svg`}
              alt="Reception Block, Rosetta Resorts, Kalyapura (Ferns Forest View)"
              loading="lazy"
            >
          </div>
          <div class="portfolio-overlay">
            <div class="overlay-content">
              <h4>Reception Block, Rosetta Resorts</h4>
              <p>High-voltage electrical contracting, aesthetic reception illumination, switchgear setup, and power distribution for Rosetta Resorts, Kalyapura.</p>
              <a href={`${baseUrl}completed-projects`} class="theme-btn border-btn">View Project</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-12 text-center mt-50">
        <a href={`${baseUrl}completed-projects`} class="theme-btn wow fadeInUp" data-wow-delay=".3s">View All Projects</a>
      </div>
    </div>
  </div>
</section>

<style>
  .portfolio-item-wrapper .portfolio-img {
    width: 100%;
    height: 380px;
    overflow: hidden;
    position: relative;
  }
  .portfolio-item-wrapper .portfolio-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s ease-in-out;
  }
  .portfolio-item-wrapper:hover .portfolio-img img {
    transform: scale(1.05);
  }
  @media (max-width: 767px) {
    .portfolio-item-wrapper .portfolio-img {
      height: 280px;
    }
  }
</style>
