---
---

<section id="portfolio" class="portfolio-section pt-130 pb-100">
  <div class="container">
    <div class="row align-items-end">
      <div class="col-xl-6 col-lg-6">
        <div class="section-title mb-60">
          <span class="wow fadeInDown" data-wow-delay=".2s">Portfolio</span>
          <h2 class="wow fadeInUp" data-wow-delay=".4s">Our Recent Works</h2>
        </div>
      </div>
      <div class="col-xl-6 col-lg-6">
        <div class="section-title mb-60">
          <p class="wow fadeInUp" data-wow-delay=".4s">A glimpse into our completed civil infrastructure, high-voltage electrical contracting, and solar PV EPC installations delivered across India.</p>
        </div>
      </div>
    </div>

    <div class="row justify-content-center">
      <!-- Project 1: M/s Janani Water Technologies Pvt Ltd -->
      <div class="col-lg-6 col-md-6 wow fadeInUp" data-wow-delay=".2s">
        <div class="portfolio-item-wrapper">
          <div class="portfolio-img">
            <img
              src="/assets/img/projects/janani-water-technologies/cover.jpg"
              alt="M/s Janani Water Technologies Pvt Ltd"
              loading="lazy"
            >
          </div>
          <div class="portfolio-overlay">
            <div class="overlay-content">
              <h4>M/s Janani Water Technologies Pvt Ltd</h4>
              <p>Electrical installation and contracting works delivered for Janani Water Technologies.</p>
              <a href="/completed-projects" class="theme-btn border-btn">View Project</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Project 2: Mr. Rohith -->
      <div class="col-lg-6 col-md-6 wow fadeInUp" data-wow-delay=".4s">
        <div class="portfolio-item-wrapper">
          <div class="portfolio-img">
            <img
              src="/assets/img/projects/rohith-residence/cover.jpg"
              alt="Mr. Rohith - Residential Project"
              loading="lazy"
            >
          </div>
          <div class="portfolio-overlay">
            <div class="overlay-content">
              <h4>Mr. Rohith</h4>
              <p>Residential construction and electrical contracting works executed to highest standards.</p>
              <a href="/completed-projects" class="theme-btn border-btn">View Project</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-12 text-center mt-50">
        <a href="/completed-projects" class="theme-btn wow fadeInUp" data-wow-delay=".3s">View All Projects</a>
      </div>
    </div>
  </div>
</section>
