---
const baseUrl = import.meta.env.BASE_URL;
---

<section id="home" class="hero-section">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-xl-6 col-lg-6">
        <div class="hero-content-wrapper">
          <h2 class="mb-25 wow fadeInDown" data-wow-delay=".2s">GlobSol Power Pvt Ltd</h2>
          <h1 class="mb-25 wow fadeInDown" data-wow-delay=".3s">Unleashing a Spectrum of Services</h1>
          <p class="mb-35 wow fadeInLeft" data-wow-delay=".4s">Elevate projects with our civil construction, interior design, electrical contracting up to 33kV, and turnkey solar PV EPC solutions across India.</p>
          <a href={`${baseUrl}services`} class="theme-btn">Our Services</a>
        </div>
      </div>
      <div class="col-xl-6 col-lg-6">
        <div class="hero-img">
          <div class="d-inline-block hero-img-right">
            <img src={`${baseUrl}assets/img/hero/hero-img.jpg`} alt="GlobSol Engineering & Contracting" class="hero-main-img wow fadeInRight" data-wow-delay=".5s">
            <img src={`${baseUrl}assets/img/hero/dots.shape.svg`} alt="" class="dot-shape">
            <div class="video-btn">
              <a href="https://www.youtube.com/watch?v=r44RKWyfcFw&fbclid=IwAR21beSJORalzmzokxDRcGfkZA1AtRTE__l5N4r09HcGS5Y6vOluyouM9EM" class="glightbox"><i class="lni lni-play"></i></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
