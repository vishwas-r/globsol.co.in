---
const baseUrl = import.meta.env.BASE_URL;
---

<section id="about" class="pt-100">
  <div class="about-section">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-xl-6 col-lg-6">
          <div class="about-img-wrapper">
            <div class="about-img position-relative d-inline-block wow fadeInLeft" data-wow-delay=".3s">
              <img src={`${baseUrl}assets/img/about/about-img.jpg`} alt="GlobSol Power Pvt Ltd About Us">

              <div class="about-experience">
                <h3>Class 1 Licensed</h3>
                <p>Govt-approved Class 1 Electrical Contractors & Solar PV EPC specialists up to 33kV.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="col-xl-6 col-lg-6">
          <div class="about-content-wrapper">
            <div class="section-title">
              <span class="wow fadeInUp" data-wow-delay=".2s">About Us</span>
              <h2 class="mb-30 wow fadeInRight" data-wow-delay=".4s">Civil & Class 1 Government-Licensed Contracting</h2>
            </div>
            <div class="about-content">
              <p class="mb-20 wow fadeInUp" data-wow-delay=".6s">We proudly introduce ourselves as Civil & Class 1 Government-licensed Electrical Contractors specializing in Construction, Electrical Installation up to 33kV, and Solar PV EPC (both on-grid and off-grid). Equipped with modern tools and technical knowledge, our skilled team executes complex electrification and building projects across India.</p>
              <p class="mb-35 wow fadeInUp" data-wow-delay=".7s">We excel in residential/commercial construction, operating substations up to 33kV, managing DG sets, and executing turnkey solar projects. Having successfully served renowned organizations such as BEL, HAL, HMT, Hitachi, and Rosetta, we are driven by continuous improvement and unyielding engineering excellence.</p>
              
              <div class="counter-up wow fadeInUp" data-wow-delay=".8s">
                <div class="counter">
                  <span id="secondo1" class="countup count color-1" cup-end="33" cup-append="kV">33kV</span>
                  <h4>High Voltage HT/LT</h4>
                  <p>Substations, power distribution & transformer installations.</p>
                </div>
                <div class="counter">
                  <span id="secondo2" class="countup count color-2" cup-end="100" cup-append="+">100+</span>
                  <h4>Projects Delivered</h4>
                  <p>Trusted by BEL, HAL, HMT, Hitachi & leading corporations.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
