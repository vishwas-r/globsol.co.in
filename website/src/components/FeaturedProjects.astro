---
const baseUrl = import.meta.env.BASE_URL;

const projects = [
  {
    title: "M/s Janani Water Technologies Pvt Ltd",
    category: "Electrical Contracting & Panels",
    tag: "Completed",
    image: `${baseUrl}assets/img/projects/janani-water-technologies/cover.jpg`,
    gridClass: "col-lg-8 col-md-12"
  },
  {
    title: "Commercial Solar Rooftop Installation",
    category: "Solar EPC",
    tag: "Completed",
    image: `${baseUrl}assets/img/projects/janani-water-technologies/gallery-1.jpg`,
    gridClass: "col-lg-4 col-md-6"
  },
  {
    title: "High Voltage Sub-Station (up to 33kV)",
    category: "Electrical Contracting",
    tag: "Ongoing",
    image: `${baseUrl}assets/img/projects/janani-water-technologies/gallery-2.jpg`,
    gridClass: "col-lg-4 col-md-6"
  },
  {
    title: "Industrial Logistics & Technical Manpower Deployment",
    category: "Logistics & Manpower",
    tag: "Completed",
    image: `${baseUrl}assets/img/projects/janani-water-technologies/gallery-3.jpg`,
    gridClass: "col-lg-8 col-md-12"
  }
];
---

<section class="py-6 py-lg-7" style="background: var(--gs-light-bg);">
  <div class="container">
    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between mb-5">
      <div>
        <span class="section-subtitle">Portfolio Highlights</span>
        <h2 class="section-title mb-0">Featured Engineering & Solar Projects</h2>
      </div>
      <div class="mt-3 mt-md-0">
        <a href={`${baseUrl}completed-projects`} class="btn btn-gs-outline border-dark text-dark px-4 py-2.5">
          View All Projects
        </a>
      </div>
    </div>

    <!-- Bento Grid -->
    <div class="row g-4">
      {projects.map((item) => (
        <div class={item.gridClass}>
          <div class="bento-card group position-relative h-100 overflow-hidden rounded-4 shadow-sm" style="min-height: 280px;">
            <div class="position-absolute inset-0 bg-cover bg-center transition-all duration-500 scale-100 group-hover:scale-105" style={`background-image: url('${item.image}'); background-size: cover; background-position: center; width: 100%; height: 100%;`}></div>
            <div class="position-absolute inset-0 bg-gradient-to-t" style="background: linear-gradient(180deg, rgba(11,19,41,0.2) 0%, rgba(11,19,41,0.85) 100%);"></div>

            <div class="position-relative z-2 p-4 h-100 d-flex flex-column justify-content-between text-white">
              <div>
                <span class={`badge ${item.tag === 'Completed' ? 'bg-success' : 'bg-warning text-dark'} px-3 py-1.5 rounded-pill font-semibold`}>
                  {item.tag}
                </span>
              </div>
              <div>
                <span class="small text-warning font-semibold tracking-wider text-uppercase">{item.category}</span>
                <h3 class="h4 text-white font-bold mb-0 mt-1" style="font-family: var(--font-heading);">{item.title}</h3>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
