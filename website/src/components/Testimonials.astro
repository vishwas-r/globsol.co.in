---
const { pathname } = Astro.url;
const baseUrl = import.meta.env.BASE_URL;
const isHome = pathname === '/' || pathname === '' || pathname === baseUrl || pathname === baseUrl.slice(0, -1);
---

<section 
  class="testimonial-section pt-150 pb-150 img-bg" 
  style={isHome ? `background-image: url('${baseUrl}assets/img/testimonial/testimonial-bg.svg')` : `background-image: url('${baseUrl}assets/img/testimonial/testimonial-bg.svg'); clip-path: none !important; -webkit-clip-path: none !important;`}
>
  <div class="container">
    <div class="row align-items-center">
      <div class="col-xl-6 col-lg-10 mx-auto">
        <div class="section-title mb-60">
          <span class="wow fadeInDown" data-wow-delay=".2s">Testimonial</span>
          <h2 class="wow fadeInUp" data-wow-delay=".4s">What Our Clients Say</h2>
        </div>
        <div class="testimonial-logo-wrapper d-flex">
          <div class="img">
            <img src={`${baseUrl}assets/img/client-logo/uideck-logo.svg`} alt="UIdeck">
          </div>
          <div class="img">
            <img src={`${baseUrl}assets/img/client-logo/pagebulb-logo.svg`} alt="Pagebulb">
          </div>
          <div class="img">
            <img src={`${baseUrl}assets/img/client-logo/lineicons-logo.svg`} alt="LineIcons">
          </div>
        </div>
      </div>
      <div class="col-xl-6 col-lg-10 mx-auto">
        <div class="testimonial-wrapper">
          <div class="testimonial-active">
            <div class="item">
              <div class="single-testimonial">
                <div class="testimonial-img">
                  <img src={`${baseUrl}assets/img/testimonial/testimonial-1.png`} alt="Testimonial author">
                </div>
                <div class="testimonial-content mb-35">
                  <img src={`${baseUrl}assets/img/testimonial/quote.svg`} alt="" class="quote">
                  <p class="pb-30">GlobSol delivered our 33kV substation project with exceptional quality, speed, and 100% CEIG statutory compliance. Their engineering team is highly dependable.</p>
                  <div class="testimonial-info">
                    <div class="testimonial-meta">
                      <h5>Commercial Project Director</h5>
                      <span>Industrial Facilities</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="item">
              <div class="single-testimonial">
                <div class="testimonial-img">
                  <img src={`${baseUrl}assets/img/testimonial/testimonial-1.png`} alt="Testimonial author">
                </div>
                <div class="testimonial-content mb-35">
                  <img src={`${baseUrl}assets/img/testimonial/quote.svg`} alt="" class="quote">
                  <p class="pb-30">Their turnkey solar PV EPC capabilities helped us transition seamlessly to clean energy while reducing operational power costs significantly.</p>
                  <div class="testimonial-info">
                    <div class="testimonial-meta">
                      <h5>Head of Infrastructure</h5>
                      <span>Enterprise Client</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
