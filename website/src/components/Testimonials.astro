<section class="testimonial-section pt-150 pb-150 img-bg" style="background-image: url('/assets/img/testimonial/testimonial-bg.svg')">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-xl-6 col-lg-10 mx-auto">
        <div class="section-title mb-60">
          <span class="wow fadeInDown" data-wow-delay=".2s">Testimonial</span>
          <h2 class="wow fadeInUp" data-wow-delay=".4s">What's Our Successful <br> Client Says</h2>
        </div>
        <div class="testimonial-logo-wrapper d-flex">
          <div class="img">
            <img src="/assets/img/client-logo/uideck-logo.svg" alt="UIdeck">
          </div>
          <div class="img">
            <img src="/assets/img/client-logo/pagebulb-logo.svg" alt="Pagebulb">
          </div>
          <div class="img">
            <img src="/assets/img/client-logo/lineicons-logo.svg" alt="LineIcons">
          </div>
        </div>
      </div>
      <div class="col-xl-6 col-lg-10 mx-auto">
        <div class="testimonial-wrapper">
          <div class="testimonial-active">
            <div class="item">
              <div class="single-testimonial">
                <div class="testimonial-img">
                  <img src="/assets/img/testimonial/testimonial-1.png" alt="Testimonial author">
                </div>
                <div class="testimonial-content mb-35">
                  <img src="/assets/img/testimonial/quote.svg" alt="" class="quote">
                  <p class="pb-30">We Crafted an awesome design library matter you're buildi business presentation websit or a complex web application our design blocks can easily.</p>
                  <div class="testimonial-info">
                    <div class="testimonial-meta">
                      <h5>Dwsaidfn Aksdow</h5>
