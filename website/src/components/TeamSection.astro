---
const baseUrl = import.meta.env.BASE_URL;
---

<section id="team" class="team-section img-bg pt-130">
  <div class="container">
    <div class="row">
      <div class="col-xl-5 col-lg-7 mx-auto">
        <div class="section-title text-center mb-60">
          <span class="wow fadeInDown" data-wow-delay=".2s">Team</span>
          <h2 class="wow fadeInUp" data-wow-delay=".4s">Meet Our Leadership</h2>
          <p class="wow fadeInUp" data-wow-delay=".6s">Experienced leadership driving logistics, electrical, and solar excellence across India.</p>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-xl-3 col-lg-3 col-md-6">
        <div class="single-team text-center mb-40 wow fadeInUp" data-wow-delay=".2s">
          <div class="team-img">
            <img src={`${baseUrl}assets/img/team/team-1.jpg`} alt="Engineering Director">
          </div>
          <div class="team-info">
            <h4>Engineering Leadership</h4>
            <span>High-Voltage Electrical (33kV)</span>
          </div>
        </div>
      </div>
      <div class="col-xl-3 col-lg-3 col-md-6">
        <div class="single-team text-center mb-40 wow fadeInUp" data-wow-delay=".4s">
          <div class="team-img">
            <img src={`${baseUrl}assets/img/team/team-2.jpg`} alt="Solar EPC Specialist">
          </div>
          <div class="team-info">
            <h4>Solar EPC Division</h4>
            <span>Turnkey Clean Energy</span>
          </div>
        </div>
      </div>
      <div class="col-xl-3 col-lg-3 col-md-6">
        <div class="single-team text-center mb-40 wow fadeInUp" data-wow-delay=".6s">
          <div class="team-img">
            <img src={`${baseUrl}assets/img/team/team-3.jpg`} alt="Logistics & Manpower Operations">
          </div>
          <div class="team-info">
            <h4>Logistics & Operations</h4>
            <span>Industrial Logistics & Manpower</span>
          </div>
        </div>
      </div>
      <div class="col-xl-3 col-lg-3 col-md-6">
        <div class="single-team text-center mb-40 wow fadeInUp" data-wow-delay=".8s">
          <div class="team-img">
            <img src={`${baseUrl}assets/img/team/team-4.jpg`} alt="CEIG Statutory Officer">
          </div>
          <div class="team-info">
            <h4>Statutory & Compliance</h4>
            <span>CEIG & Grid Approvals</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
