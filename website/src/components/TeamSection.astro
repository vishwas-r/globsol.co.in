---
const baseUrl = import.meta.env.BASE_URL;
---

<section id="team" class="team-section pt-100 pb-100" style="background-color: #EFF2F9;">
  <div class="container">
    <div class="row">
      <div class="col-xl-5 col-lg-7 mx-auto">
        <div class="section-title text-center mb-60">
          <span class="wow fadeInDown" data-wow-delay=".2s">Team</span>
          <h2 class="wow fadeInUp" data-wow-delay=".4s">Meet Our Leadership</h2>
          <p class="wow fadeInUp" data-wow-delay=".6s">Experienced leadership driving high-voltage electrical, turnkey solar EPC, and industrial contracting excellence across India.</p>
        </div>
      </div>
    </div>
    <div class="row justify-content-center">
      <div class="col-xl-4 col-lg-5 col-md-6">
        <div class="single-team text-center mb-40 wow fadeInUp" data-wow-delay=".2s">
          <div class="team-img">
            <img src={`${baseUrl}assets/img/team/team-placeholder.svg`} alt="Girish R - Co-Founder / Director">
          </div>
          <div class="team-info">
            <h4>Girish R</h4>
            <span>Co-Founder / Director</span>
          </div>
        </div>
      </div>
      <div class="col-xl-4 col-lg-5 col-md-6">
        <div class="single-team text-center mb-40 wow fadeInUp" data-wow-delay=".4s">
          <div class="team-img">
            <img src={`${baseUrl}assets/img/team/team-placeholder.svg`} alt="Prashanth N - Co-Founder">
          </div>
          <div class="team-info">
            <h4>Prashanth N</h4>
            <span>Co-Founder</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
